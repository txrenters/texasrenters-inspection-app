# Development environment — the whole stack, in one file.
#
#   cp .env.development.example .env.development
#   npm run docker:up
#
# Compose reads this through `--env-file`, which is the only source it consults
# for `${...}` interpolation — a service's own `env_file:` is never read for it.
# That matters for the NEXT_PUBLIC_* build args below, which have to be
# interpolated at build time or the console ships pointing at the wrong backend.
#
# `.env.development` is gitignored. This example is not: keep it free of real
# credentials and keep it in step when a variable is added.

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
NODE_ENV=development
COMPOSE_PROJECT_NAME=texasrenters

# -----------------------------------------------------------------------------
# Hostnames
#
# Everything the browser, the phone and the server each use to find the others.
# `backend` and `postgres` are Compose service names: inside a container
# `localhost` is that container, not the host.
# -----------------------------------------------------------------------------
BACKEND_PORT=3000
WEB_PORT=5454

# Browser -> backend. A BUILD ARG: Next inlines it into the bundle, so changing
# it means rebuilding the web image, not restarting it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Console server -> backend, container to container.
API_INTERNAL_BASE_URL=http://backend:3000

# Backend -> the console, for the links in shared-report emails.
WEB_APP_ORIGIN=http://localhost:5454
MOBILE_APP_ORIGIN=http://localhost:8082
CORS_ALLOWED_ORIGINS=http://localhost:5454,http://localhost:5456,http://localhost:8081,http://localhost:8082,http://localhost:19006

# -----------------------------------------------------------------------------
# Database
#
# The Postgres container in this project. DIRECT_URL is the unpooled connection
# Prisma migrations use.
# -----------------------------------------------------------------------------
POSTGRES_DB=texasrenters
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/texasrenters?schema=public
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/texasrenters?schema=public
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_WARMUP_ENABLED=true
RLS_TENANT_SCOPE_ENABLED=true

# Host ports for inspecting the containers. Shifted off the defaults so a
# Postgres or Redis already on the workstation does not collide.
POSTGRES_PORT=55433
REDIS_PORT=56380
PGADMIN_PORT=5480

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_PROVIDER=redis
CACHE_FAIL_OPEN=true

# -----------------------------------------------------------------------------
# Credentials — fill these in, never commit them
#
# Every value below is a secret. None may be copied into a NEXT_PUBLIC_* or
# EXPO_PUBLIC_* variable: those prefixes ship their value to every device.
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=https://texasrenters.local
AUTH_JWT_AUDIENCE=authenticated
AI_CREDENTIALS_ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Cloudflare allows ONE webhook URL per account. Setting this in production
# takes it away from development — see the deployment notes.
CLOUDFLARE_STREAM_WEBHOOK_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
INSPECTION_MEDIA_STORAGE_PROVIDER=r2
INSPECTION_MEDIA_STORAGE_BUCKET=
FLOOR_PLAN_STORAGE_PROVIDER=local
FLOOR_PLAN_STORAGE_BUCKET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRANSCRIPTION_API_KEY=

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MAIL_FROM_ADDRESS=

PROPERTYWARE_CLIENT_ID=
PROPERTYWARE_CLIENT_SECRET=
PROPERTYWARE_BASE_URL=https://api.propertyware.com/pw/api/rest/v1
PROPERTYWARE_SYNC_ENABLED=false
PROPERTYWARE_ORGANIZATION_ID=

# Propertyware's identifier for the account is above; this is *our*
# organization's UUID in this database. Automatic sync needs both, and with
# this unset the console reports "no organization is configured".
PROPERTYWARE_LOCAL_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
# Incremental sync cadence (delta pull). Daily at 00:00.
PROPERTYWARE_INCREMENTAL_SYNC_CRON=0 0 * * *
# Full reconciliation. Daily at 02:00; monthly would be "0 2 1 * *".
PROPERTYWARE_RECONCILIATION_CRON=0 2 * * *

# -----------------------------------------------------------------------------
# Seed account — development convenience
# -----------------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_RESET_PASSWORD=false

# -----------------------------------------------------------------------------
# Report branding
# -----------------------------------------------------------------------------
REPORT_BRAND_NAME=TexasRenters.com
REPORT_BRAND_ADDRESS_LINE1=
REPORT_BRAND_ADDRESS_LINE2=
REPORT_BRAND_PHONE=
REPORT_BRAND_EMAIL=
