# The shipped app uses the REST API. Demo data is test/development-only and must be explicit.
EXPO_PUBLIC_ENABLE_DEMO_DATA=false
# Required for the mobile application.
# In Expo Go LAN development, localhost is automatically mapped to the Metro host PC.
# Expo tunnel development securely proxies this REST URL through Metro to the local backend.
# The mobile start scripts also derive a private-LAN fallback automatically.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# USB development (Android only): set to true when using
# `adb reverse tcp:3000 tcp:3000` so the device keeps talking to localhost
# instead of the (possibly isolated) LAN IP. iOS has no adb; on networks with
# client isolation, run iOS through the Expo tunnel: pnpm start:tunnel
EXPO_PUBLIC_USE_ADB_REVERSE=false
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Required for remote notifications in a development/production build.
# Find this in the Expo project dashboard after linking the app with EAS.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_ENABLE_TEST_VIDEO_PICKER=false
