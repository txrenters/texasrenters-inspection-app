{
  "name": "@texasrenters/mobile-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/start.mjs lan",
    "start:lan": "node scripts/start.mjs lan",
    "start:tunnel": "expo start --tunnel --go",
    "start:clear": "node scripts/start.mjs lan --clear",
    "dev:mobile:tunnel": "pnpm start:tunnel",
    "predev": "pnpm --filter @texasrenters/shared build",
    "dev": "node scripts/start.mjs lan",
    "predev:lan": "pnpm --filter @texasrenters/shared build",
    "dev:lan": "node scripts/start.mjs lan",
    "predev:clear": "pnpm --filter @texasrenters/shared build",
    "dev:clear": "node scripts/start.mjs lan --clear",
    "dev:client": "node scripts/start.mjs lan --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "pnpm --filter @texasrenters/shared build",
    "build": "expo export --platform web --output-dir dist",
    "lint": "eslint app src tests",
    "pretypecheck": "pnpm --filter @texasrenters/shared build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @texasrenters/shared build",
    "test": "jest --runInBand",
    "start:tunnel:clear": "expo start --tunnel --go --clear"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "^5.2.2",
    "@rn-primitives/alert-dialog": "^1.5.2",
    "@rn-primitives/dialog": "^1.5.2",
    "@rn-primitives/label": "^1.5.2",
    "@rn-primitives/portal": "^1.3.0",
    "@rn-primitives/progress": "^1.3.0",
    "@rn-primitives/radio-group": "^1.5.2",
    "@rn-primitives/separator": "^1.3.0",
    "@rn-primitives/slot": "^1.5.2",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "5.101.2",
    "@texasrenters/shared": "workspace:*",
    "babel-preset-expo": "~54.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "54.0.36",
    "expo-camera": "17.0.10",
    "expo-constants": "^18.0.13",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-linking": "^8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sqlite": "16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "lucide-react-native": "^0.545.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "7.81.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "4.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "jest": "29.7.0",
    "jest-expo": "~54.0.17",
    "tailwindcss-animate": "^1.0.7",
    "test-renderer": "1.1.0"
  }
