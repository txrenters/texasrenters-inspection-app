model InspectionAssignment {
  id             String                @id @default(uuid()) @db.Uuid
  inspectionId   String                @db.Uuid
  technicianId   String                @db.Uuid
  /// Who assigned it. Null when the Jobber sync copied a coordinator's
  /// assignment across — there is no person here who made that call, and naming
  /// one would be a lie. Mirrors AuditLog.actorUserId.
  assignedById   String?               @db.Uuid
  endedById      String?               @db.Uuid
  supersedesId   String?               @unique @db.Uuid
  status         String                @default("ASSIGNED")
  isCurrent      Boolean               @default(true)
  assignedAt     DateTime              @default(now())
  endedAt        DateTime?
  reason         String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  inspection     Inspection            @relation(fields: [inspectionId], references: [id])
  technician     UserProfile           @relation("AssignedTechnician", fields: [technicianId], references: [id])
  assignedBy     UserProfile?          @relation("AssignmentActor", fields: [assignedById], references: [id])
  endedBy        UserProfile?          @relation("AssignmentEndActor", fields: [endedById], references: [id])
  supersedes     InspectionAssignment? @relation("AssignmentSupersession", fields: [supersedesId], references: [id])
  supersededBy   InspectionAssignment? @relation("AssignmentSupersession")

  @@index([inspectionId, isCurrent])
  @@index([technicianId, isCurrent, status])
}

model InspectionArea {
  id                   String                            @id @default(uuid()) @db.Uuid
  inspectionId         String                            @db.Uuid
  propertyAreaId       String                            @db.Uuid
  completionStatus     InspectionAreaCompletionStatus    @default(PENDING)
  skipReason           String?
  technicianNote       String?
  completedAt          DateTime?
  // The technician's attestation that the AI's narrative summary matches the
  // walkthrough they performed. Deliberately NOT InspectionFinding.reviewedBy:
  // that pair records an admin approving or rejecting a finding, and a
  // technician must never write to it. This says only "I read this and it
  // reflects what I saw" — it changes no finding's review status.
  summaryConfirmedAt   DateTime?
  summaryConfirmedById String?                           @db.Uuid
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  inspection           Inspection                        @relation(fields: [inspectionId], references: [id])
  propertyArea         PropertyArea                      @relation(fields: [propertyAreaId], references: [id])
  media                InspectionMedia[]
  photos               InspectionPhoto[]
  statusHistory        InspectionAreaStatusHistory[]
  uploadSessions       MediaUploadSession[]
  checklistResponses   InspectionAreaChecklistResponse[]
  areaEvidenceRequests AreaEvidenceRequest[]

  @@unique([inspectionId, propertyAreaId])
  @@index([inspectionId])
}

model InspectionAreaStatusHistory {
  id               String                          @id @default(uuid()) @db.Uuid
  inspectionAreaId String                          @db.Uuid
  fromStatus       InspectionAreaCompletionStatus?
  toStatus         InspectionAreaCompletionStatus
  reason           String?
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt
  inspectionArea   InspectionArea                  @relation(fields: [inspectionAreaId], references: [id])
}

model InspectionMedia {
  id                      String                @id @default(uuid()) @db.Uuid
  organizationId          String                @db.Uuid
  propertyId              String?               @db.Uuid
  inspectionId            String                @db.Uuid
  inspectionAreaId        String                @db.Uuid
  technicianId            String                @db.Uuid
  provider                String
  // Provider-side identity, and the client idempotency key for retried uploads.
  providerMediaId         String                @unique
  // Where the bytes live in the storage bucket. Kept separate from
  // providerMediaId so the storage backend can change without rewriting
  // identity, and so keys can be tenant-scoped like photos and floor plans.
  //
  // Nullable since the Stream migration: a video uploaded straight from the
  // device to Cloudflare Stream never passes through this backend and has no
  // bucket object. Every pre-migration recording still has one and still plays
  // from it, which is what keeps legacy evidence viewable.
  storageKey              String?
  mimeType                String
  durationSeconds         Int
  // PRIMARY_AREA is the one required room walkthrough (one per area, enforced by
  // a partial unique index); ADDITIONAL_ISSUE videos are extra labeled clips.
  recordingType           VideoRecordingType    @default(PRIMARY_AREA)
  label                   String?
  category                String?
  // Optional link to a finding (validated in app code; no Prisma relation to
  // avoid a second media↔finding relation). Plain FK enforced in the migration.
  relatedFindingId        String?               @db.Uuid
  captureGuidelineVersion String?
  captureSessionId        String?               @unique
  capturePolicyVersion    String?
  // Summarized capture metrics only. Raw motion samples stay on the device.
  captureSummary          Json?
  uploadStatus            MediaUploadStatus     @default(PENDING)
  // Encoding state at the provider, kept distinct from uploadStatus: bytes
  // arriving and the video being playable are different events, and Stream can
  // fail the second after succeeding at the first. No third "playbackStatus" —
  // for Stream, READY here *is* playable, and a duplicate field would only
  // create two answers to one question and eventually disagree.
  processingStatus        MediaProcessingStatus @default(PENDING)

  // --- Cloudflare Stream ---
  // Null for every recording made before the Stream migration; those keep
  // playing from `storageKey` in R2. Presence of this is what marks a record as
  // Stream-backed, so no backfill is needed and no legacy evidence is stranded.
  streamUid            String?   @unique
  // What the client says it will send, and what the provider has confirmed.
  // Percentage is derived rather than stored — a stored copy is one more thing
  // that can disagree with the bytes it summarises.
  uploadBytesTotal     Int?
  uploadBytesCompleted Int?
  originalFilename     String?
  // Distinct from createdAt: when the technician recorded it, which can be
  // hours before a queued upload reaches the API from a property with no signal.
  recordedAt           DateTime?
  uploadedAt           DateTime?
  readyAt              DateTime?
  failedAt             DateTime?
  failureCode          String?
  failureMessage       String?
  retryCount           Int       @default(0)
  // The device-side queue id, so a technician's stuck upload can be traced from
  // a support call to a row without guessing.
  localQueueId         String?
  // Filled from the ready webhook; the provider is authoritative for these.
  thumbnailUrl         String?
  widthPx              Int?
  heightPx             Int?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  inspectionArea   InspectionArea         @relation(fields: [inspectionAreaId], references: [id])
  technician       UserProfile            @relation(fields: [technicianId], references: [id])
  processingEvents MediaProcessingEvent[]
  transcriptionJob TranscriptionJob?
  aiJobs           AiAnalysisJob[]
  findings         InspectionFinding[]

  // One PRIMARY_AREA video per area is enforced by a partial unique index in the
  // migration; the plain index here supports lookups by area.
  @@index([inspectionAreaId])
}

/// Photo evidence for an area. Unlike the single primary video, an area (and a
/// finding) may have many photos, each tagged with a capture type. Photos never
/// enter the video transcription/AI pipeline.
model InspectionPhoto {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @db.Uuid
  inspectionId     String             @db.Uuid
  inspectionAreaId String             @db.Uuid
  findingId        String?            @db.Uuid
  /// The checklist item this photograph evidences.
  ///
  /// The office's printed report captions every photograph with the item it
  /// documents — "WALLS & CEILINGS", "DOORS & LOCKS" — so the table states the
  /// verdict and the photographs beneath it prove that verdict, item by item.
  /// Without this link a photo can only carry free text, and the report cannot
  /// group evidence under the row it belongs to.
  ///
  /// Nullable and SetNull on delete: plenty of photographs document the room
  /// generally rather than one item, and an administrator archiving a
  /// checklist item must not delete the evidence captured against it.
  checklistItemId  String?            @db.Uuid
  capturedById     String             @db.Uuid
  provider         String             @default("local")
  storageKey       String             @unique
  thumbnailKey     String?
  captureType      PhotoCaptureType   @default(AREA_OVERVIEW)
  sequenceNumber   Int                @default(0)
  label            String?
  notes            String?
  mimeType         String
  storageStatus    PhotoStorageStatus @default(UPLOADED)
  width            Int?
  height           Int?
  sizeBytes        Int?
  idempotencyKey   String?            @unique
  localFileId      String?
  metadata         Json?
  capturedAt       DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  inspectionArea   InspectionArea     @relation(fields: [inspectionAreaId], references: [id], onDelete: Cascade)
  finding          InspectionFinding? @relation(fields: [findingId], references: [id], onDelete: SetNull)
  capturedBy       UserProfile        @relation(fields: [capturedById], references: [id])
  checklistItem    AreaChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@index([inspectionAreaId, checklistItemId])
  @@index([inspectionAreaId, captureType, sequenceNumber])
  @@index([inspectionId])
  @@index([findingId])
}

