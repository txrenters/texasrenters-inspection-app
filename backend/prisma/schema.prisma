  requiresReview         Boolean                   @default(false)
  summary                String?
  originalClassification ComparisonClassification?
  overriddenById         String?                   @db.Uuid
  overriddenAt           DateTime?
  overrideReason         String?
  metadata               Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  comparison             InspectionComparison      @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId])
}

/// Configurable charge rule (spec §13/§14). The $25 unauthorized-pet amount is
/// stored here, never hard-coded, and applies only while `isActive`.
model ChargeRule {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  code            String
  description     String?
  amount          Decimal               @db.Decimal(10, 2)
  currency        String                @default("USD")
  calculationType ChargeCalculationType @default(PER_UNIQUE_ENTITY)
  effectiveFrom   DateTime              @default(now())
  effectiveTo     DateTime?
  isActive        Boolean               @default(true)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

/// A technician's raw pet observation during an occupied inspection. Evidence
/// only — the technician never determines uniqueness, authorization, or charges.
model PetObservation {
  id                    String        @id @default(uuid()) @db.Uuid
  /// Client-supplied, so a retried submission records one sighting.
  ///
  /// This is the only technician write that appends rather than sets a value:
  /// note, skip and complete all land on the same state whether applied once
  /// or twice, and media and area creation already carry keys. Without this
  /// one, a request whose response was lost would record the same animal
  /// again on retry — and a duplicate pet is a charge somebody has to argue
  /// about.
  idempotencyKey        String?       @unique
  organizationId        String        @db.Uuid
  inspectionId          String        @db.Uuid
  propertyAreaId        String?       @db.Uuid
  petCandidateId        String?       @db.Uuid
  temporaryLabel        String
  species               String
  description           String?
  characteristics       String?
  notes                 String?
  photoIds              String[]      @db.Uuid
  mediaIds              String[]      @db.Uuid
  possibleDuplicateOfId String?       @db.Uuid
  recordedById          String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  petCandidate          PetCandidate? @relation(fields: [petCandidateId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@index([petCandidateId])
}

/// A deduplicated unique animal grouped from one or more observations. A reviewer
/// confirms uniqueness and authorization; a charge applies only to a UNIQUE_PET
/// that is UNAUTHORIZED.
model PetCandidate {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  inspectionId        String                 @db.Uuid
  species             String
  label               String
  description         String?
  reviewStatus        PetReviewStatus        @default(PENDING_REVIEW)
  authorizationStatus PetAuthorizationStatus @default(UNKNOWN)
  observationCount    Int                    @default(0)
  reviewedById        String?                @db.Uuid
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  observations        PetObservation[]
  charges             Charge[]

  @@index([inspectionId])
}

/// A proposed or decided charge (spec §14). Amounts are Decimal money. A charge
/// is only ever finalized (APPROVED/REJECTED/ADJUSTED/WAIVED) by a human — the
/// generator drafts, it never approves.
model Charge {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  inspectionId   String        @db.Uuid
  chargeCode     String
  description    String
  propertyAreaId String?       @db.Uuid
  findingId      String?       @db.Uuid
  petCandidateId String?       @db.Uuid
  quantity       Int           @default(1)
  unitAmount     Decimal       @db.Decimal(10, 2)
  proposedAmount Decimal       @db.Decimal(10, 2)
  approvedAmount Decimal?      @db.Decimal(10, 2)
  currency       String        @default("USD")
  status         ChargeStatus  @default(DRAFT)
  source         ChargeSource  @default(SYSTEM)
  reason         String?
  evidenceRefs   Json?
  reviewedById   String?       @db.Uuid
  reviewedAt     DateTime?
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  petCandidate   PetCandidate? @relation(fields: [petCandidateId], references: [id], onDelete: SetNull)

  @@index([inspectionId, status])
  @@index([petCandidateId])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String?      @db.Uuid
  /// The API client that acted, when the actor was a machine rather than a
  /// person. Without it a third-party write is indistinguishable from an
  /// anonymous one, because `actorUserId` is null for every key-authenticated
  /// request — and "who changed this" is the entire point of the table.
  actorApiClientId String?    @db.Uuid
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId, createdAt])
}

model WebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  status          WebhookProcessingStatus @default(RECEIVED)
  payloadHash     String
  processedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([provider, providerEventId])
}

/// One position report from a technician's handset.
///
/// Append-only and high volume: a phone on shift produces one of these every
/// minute or two, so nothing here is edited after the fact and the table is
/// pruned on a schedule rather than kept for ever.
model TechnicianLocationPing {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  technicianId   String @db.Uuid

  /// `Decimal(9, 6)`, not the `Decimal(6, 5)` the floor-plan markers use. That
  /// type holds a single integer digit and cannot represent a longitude at all
  /// — -97.7431 would overflow it. Six decimal places is roughly 11cm, far
  /// finer than any phone's GPS actually resolves.
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  /// The radius the device claims, in metres. Kept because a 2km fix and a 5m
  /// fix mean entirely different things on a map, and drawing them the same
  /// way would be the map lying.
  accuracyMeters Int?

  /// 0-100 where the handset reports it. A trail that simply stops says much
  /// more when you can see the battery was nearly flat when it did.
  batteryPercent Int?

  /// When the handset took the fix, which is not when the API heard about it.
  /// The same split `InspectionMedia.recordedAt` exists for: a point captured
  /// in a basement arrives whenever signal returns, sometimes hours later, and
  /// ordering a trail by arrival would draw the route in the wrong sequence.
  recordedAt DateTime
  createdAt  DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  technician   UserProfile  @relation("TechnicianLocation", fields: [technicianId], references: [id])

  /// One technician's trail, in order.
  @@index([technicianId, recordedAt])
  /// Everyone's latest position, for the map.
  @@index([organizationId, recordedAt])
}

/// Whether a client's keys address production or a sandbox. Carried in the key
/// itself (`trk_live_` / `trk_test_`) so a credential pasted into the wrong
/// environment is obvious on sight rather than after it writes something.
enum ApiClientEnvironment {
  LIVE
  TEST
}

/// A registered third-party integration.
///
/// The principal a machine credential resolves to. It deliberately mirrors the
/// shape of a human principal — one organization, a set of permission keys — so
/// the existing PermissionsGuard, tenant interceptor and row-level security
/// apply to third-party traffic unchanged, rather than a second authorization
/// path existing for machines to drift out of step with.
///
/// Permissions here are a subset: MACHINE_FORBIDDEN_PERMISSIONS can never
/// appear, enforced when a client is created rather than only when it calls.
model ApiClient {
  id                 String               @id @default(uuid()) @db.Uuid
  organizationId     String               @db.Uuid
  name               String
  description        String?
  environment        ApiClientEnvironment @default(LIVE)
  permissions        String[]
  /// Requests per minute, counted per client across every key it holds.
  rateLimitPerMinute Int                  @default(60)
  /// Require an HMAC body signature in addition to the key. Off by default for
  /// read-only integrations; the API refuses to open a write route to a client
  /// without it.
  requireSignature   Boolean              @default(false)
  /// Optional source-address allowlist. Empty means any address.
  allowedIps         String[]
  isActive           Boolean              @default(true)
  createdByUserId    String?              @db.Uuid
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  revokedAt          DateTime?
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keys               ApiClientKey[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// One issued credential for a client.
///
/// Separate from ApiClient so a key can be rotated without the integration
/// losing its identity, its scopes or its audit history: issue the replacement,
/// let both work while the third party redeploys, then revoke the old one.
///
/// The secret is never stored. `prefix` is the non-secret half — indexed, and
/// safe to show in a console or a log line — and `secretHash` is a keyed hash
/// of the other half, compared in constant time.
model ApiClientKey {
  id              String    @id @default(uuid()) @db.Uuid
  apiClientId     String    @db.Uuid
  /// Denormalised from the client so row-level security can police this table
  /// with the same predicate as every other, without a join.
  organizationId  String    @db.Uuid
  prefix          String    @unique
  secretHash      String
  /// What this key is for ("staging worker"), so revoking the right one does
  /// not require guessing from timestamps.
  label           String?
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  createdByUserId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?
  client          ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([apiClientId, revokedAt])
}


/// Whether this organization's Jobber account is currently usable.
///
/// Distinct from "has tokens": a refresh token can be revoked by Jobber without
/// us being told (plan downgrade, admin deactivation, secret regeneration), so
/// the sync needs a state it can set when a refresh is rejected. Nulling the
/// tokens instead would lose the account identity and make the console unable
/// Which system booked an inspection.
enum InspectionSource {
  MANUAL
  JOBBER
  /// A report from another system, read in from its PDF. Distinct from MANUAL
  /// because the evidence was not captured here: nobody on this system walked
  /// the property, and a charge argued from it rests on somebody else's record.
  IMPORTED_REPORT
}

/// to say *which* connection needs attention.
enum JobberConnectionStatus {
  CONNECTED
  DISCONNECTED
  /// Tokens exist but Jobber refused them. Only a fresh admin consent fixes it.
  REAUTHORIZATION_REQUIRED
}

/// One Jobber account authorized against one of our organizations.
///
/// `organizationId` is unique: Jobber's authorization is per-account and the
/// scheduling source of record cannot be ambiguous. A second Jobber account
/// would mean two systems claiming to own the same inspection calendar.
model JobberConnection {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @unique @db.Uuid
  /// Jobber's own account id, read via `query { account { id name } }` right
  /// after the exchange. Stored so a re-authorization that lands on a different
  /// Jobber account is detected instead of silently swapping the calendar.
  jobberAccountId        String?
  jobberAccountName      String?
  status                 JobberConnectionStatus @default(DISCONNECTED)
  /// AES-256-GCM envelopes, never the raw tokens. See common/secret-envelope.ts.
  accessTokenCiphertext  String?
  /// From the token response's `expires_in` (60 minutes today). Persisted so a
  /// restarted process refreshes on schedule rather than after a first 401.
  accessTokenExpiresAt   DateTime?
  refreshTokenCiphertext String?
  /// Jobber rotates refresh tokens; this records when we last stored a new one,
  /// which is the only signal that rotation is working before a token dies.
  lastRefreshedAt        DateTime?
  /// Sanitized reason the last refresh failed. Never the provider body — that
  /// echoes the request, which carries the client secret.
  lastRefreshError       String?
  scopes                 String[]               @default([])
  /// The schema date in force when consent was granted, kept so a later pin
  /// change is visible as a change rather than inferred from deploy history.
  apiVersion             String?
  /// Plain column, no FK — matches ApiClient.createdByUserId. The person who
  /// consented may be deprovisioned later without invalidating the connection.
  connectedByUserId      String?                @db.Uuid
  connectedAt            DateTime?
  disconnectedAt         DateTime?
  /// Sync state, kept on the connection rather than in its own table: there is
  /// exactly one Jobber calendar per organization, so a run history would be a
  /// table with one meaningful row. What a person needs to see is "is it
  /// running, did the last one work", and that is these four columns.
  lastSyncStartedAt      DateTime?
  lastSyncCompletedAt    DateTime?
  /// Sanitized. Never the provider body, which echoes the request.
  lastSyncError          String?
  lastSyncVisitCount     Int?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}


/// How confidently a Jobber property was tied to one of ours.
enum JobberLinkStatus {
  /// Resolved to exactly one building (and unit, where the building has them).
  LINKED
  /// Nothing matched. Nothing is imported for this property until a human says
  /// what it is.
  UNMATCHED
  /// More than one candidate matched. Deliberately NOT auto-resolved: picking
  /// one would send a technician to a door nobody chose.
  AMBIGUOUS
  /// A human decided this Jobber property is not ours to inspect. Kept as a row
  /// so the queue does not re-offer it on every sync.
  IGNORED
}

/// How the link was arrived at, kept because "a person chose this" and "the
/// addresses happened to be spelled the same" are very different claims when
/// the link later turns out to be wrong.
enum JobberLinkMethod {
  /// Exactly one building matched on normalized address. Automatic.
  ADDRESS_EXACT
  /// An administrator picked the building.
  MANUAL
}

/// One Jobber property, tied to the Propertyware records an inspection needs.
///
/// This table exists because Jobber and Propertyware share no key. An
/// `Inspection` cannot be created without a `propertywareBuildingId`, and
/// nothing in a Jobber visit supplies one — so every visit has to pass through
/// a mapping somebody can inspect and correct. Unmatched rows are the queue:
/// they are created on the first sync that sees the property, so the work is
/// visible before anyone is waiting on it.
model JobberPropertyLink {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @db.Uuid
  /// Jobber's own identifiers. The property id is the one that matters; the
  /// client is kept so the console can group a landlord's properties together.
  jobberPropertyId       String
  jobberClientId         String?
  jobberClientName       String?
  /// The address exactly as Jobber holds it, so the console can show what it is
  /// being asked to match without another API call — and so a queue built
  /// months ago still reads correctly if Jobber's record later changes.
  jobberAddress          String?
  /// Lowercased, punctuation-stripped street + postal code. Stored rather than
  /// computed per query so matching is one indexed lookup, and so the exact
  /// string a match was made on survives any later change to normalization.
  normalizedAddressKey   String?
  status                 JobberLinkStatus      @default(UNMATCHED)
  method                 JobberLinkMethod?
  propertywareBuildingId String?               @db.Uuid
  propertywareUnitId     String?               @db.Uuid
  propertywareLeaseId    String?               @db.Uuid
  /// Why this row is still in the queue, in words the console can show.
  unresolvedReason       String?
  linkedByUserId         String?               @db.Uuid
  linkedAt               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propertywareBuilding   PropertywareBuilding? @relation(fields: [propertywareBuildingId], references: [id])
  propertywareUnit       PropertywareUnit?     @relation(fields: [propertywareUnitId], references: [id])
  propertywareLease      PropertywareLease?    @relation(fields: [propertywareLeaseId], references: [id])
  visitImports           JobberVisitImport[]

  /// One link per Jobber property. Two would mean two answers to "which
  /// building is this", and the sync would pick whichever it read first.
  @@unique([organizationId, jobberPropertyId])
  @@index([organizationId, status])
  @@index([organizationId, normalizedAddressKey])
}

/// What happened to one Jobber visit.
enum JobberVisitImportStatus {
  /// Seen, not yet turned into an inspection.
  PENDING
  IMPORTED
  /// Its property has no link yet. Resolves itself once the link is made.
  UNMATCHED_PROPERTY
  /// A scheduling rule refused it — no approved areas, no baseline, a clash.
  /// Needs a person, not a retry.
  REJECTED
  /// A human decided this visit is not an inspection.
  IGNORED
  /// The visit's type is one this integration deliberately does not import —
  /// filter delivery, which is a delivery rather than an inspection. A decision
  /// already made, not a problem to solve, so it is kept out of the work queue.
  SKIPPED_NOT_SYNCED
  /// Already finished in Jobber when we first saw it. Not a failure: the window
  /// reaches into the past, and work that has happened must not become an
  /// inspection somebody is asked to perform. Retained rather than dropped so
  /// the console can show what the calendar held.
  SKIPPED_COMPLETE
}

/// One Jobber visit and the inspection it did or did not become.
///
/// Gives the sync idempotency that does not depend on the inspection existing:
/// a visit refused by a scheduling rule has no `Inspection` row to record the
/// refusal on, and without this the next sync would retry it forever and the
/// office would never learn it was dropped.
model JobberVisitImport {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  jobberVisitId  String
  jobberJobId    String?
  linkId         String?                 @db.Uuid
  status         JobberVisitImportStatus @default(PENDING)
  /// The stable application error code, so the console can group failures
  /// rather than string-matching prose.
  failureCode    String?
  failureMessage String?
  /// The visit as Jobber sent it, kept for the console and for re-running a
  /// decision without another API call.
  payload        Json?
  inspectionId   String?                 @db.Uuid
  attempts       Int                     @default(0)
  lastAttemptAt  DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  link           JobberPropertyLink?     @relation(fields: [linkId], references: [id])

  /// One import record per visit, which is what makes a replayed webhook or an
  /// overlapping sync window harmless.
  @@unique([organizationId, jobberVisitId])
  @@index([organizationId, status])
  @@index([linkId, status])
}


/// What we send back to Jobber. One value today, as an enum because the second
/// one is foreseeable and a boolean column would have to be migrated away.
enum JobberOutboundKind {
  VISIT_COMPLETED
}

enum JobberOutboundStatus {
  PENDING
  SENT
  /// Failed, will be retried after `nextAttemptAt`.
  FAILED
  /// Out of attempts. Needs a person; never retried automatically.
  ABANDONED
}

/// Work owed to Jobber, written in the same transaction as the thing that owes
/// it.
///
/// An outbox rather than a call at the point of finalization. Finalization is
/// the moment an administrator signs off on evidence, and it must not fail
/// because Jobber is unreachable — nor should it be rolled back by a network
/// error after `finalizedAt` has frozen the evidence. Enqueuing inside the same
/// transaction is what makes "finalized" and "Jobber will be told" a single
/// atomic fact.
model JobberOutboundTask {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  inspectionId   String               @db.Uuid
  jobberVisitId  String
  jobberJobId    String?
  kind           JobberOutboundKind
  status         JobberOutboundStatus @default(PENDING)
  attempts       Int                  @default(0)
  /// When this becomes eligible again. Exponential backoff on failure, so a
  /// Jobber outage does not turn into a retry storm against a rate limiter.
  nextAttemptAt  DateTime             @default(now())
  /// Sanitized. Never the provider body.
  lastError      String?
  sentAt         DateTime?
  /// Who signed the inspection off. The report share this task publishes is
  /// created in their name, because a share link needs an owner and this is the
  /// person whose sign-off produced it.
  ///
  /// Null when the technician's submission enqueued the task and no
  /// administrator has finalized yet: a technician is not the owner of a report
  /// share. A later finalize claims it while the task is still unsent.
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspection     Inspection           @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  /// One completion push per inspection. A re-finalize must not tell Jobber
  /// twice, and the enqueue relies on this rather than on reading first.
  @@unique([organizationId, inspectionId, kind])
  @@index([organizationId, status, nextAttemptAt])
}

/// An error that happened on somebody's phone or in their browser.
///
/// The handset has kept an error log since it was built and the console kept
/// none at all — but neither ever reached anybody who could act on it. A
/// technician's crash lived on their phone until they reinstalled, and the only
/// way to learn of it was for them to describe it out loud.
///
/// Written by clients, so nothing in here is trusted: it is evidence *about* a
/// client, not a statement *from* one. Rendered as text, never executed, and
/// redacted on both sides before it is stored.
model ClientErrorReport {
  id String @id @default(uuid()) @db.Uuid

  /// Null for an error raised before anybody signed in.
  ///
  /// Those are the ones most worth having. A failed sign-in, an API address
  /// that no longer answers, a build that cannot reach anything — none of them
  /// have a session, by definition, and a log that required one would be empty
  /// exactly when it mattered. The cost is an endpoint anonymous callers can
  /// write to, which is why it is capped and rate limited rather than open.
  organizationId String? @db.Uuid

  authUserId String?

  /// The handset or the console.
  source ClientErrorSource

  /// The client's own id for the entry, so re-sending a log that was never
  /// acknowledged cannot fill the table with copies of one crash.
  clientEntryId String

  /// Stable per install, and not a person. Pairs with `clientEntryId` as the
  /// deduplicating key, and lets one handset's story be read end to end
  /// without knowing who was holding it.
  installId String

  message String

  /// Truncated by the client before sending: the stack of a minified bundle is
  /// long and the useful part is the top.
  stack String?

  /// The client's own label for where it was raised — `update-fetch`, `root`,
  /// `signIn`. A name somebody chose, not a stack frame.
  context String?

  /// A crash, as opposed to something caught and carried on from.
  fatal Boolean @default(false)

  platform   String?
  appVersion String?
  buildId    String?

  /// The API address the client was actually talking to.
  ///
  /// Here because of the afternoon this was built: a handset answered HTTP 530
  /// and the one fact nobody could get at was which host it had asked. It is
  /// the first question of every report like it, and the client is the only
  /// thing that knows.
  apiBaseUrl String?

  /// When the client says it happened, and when we heard. They differ by
  /// however long the phone was offline, which is often the whole story.
  occurredAt DateTime
  receivedAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One row per client entry. The flush is at-least-once and re-sends whatever
  /// it has not had acknowledged, which this is what makes safe.
  @@unique([installId, clientEntryId])
  @@index([organizationId, receivedAt])
  @@index([source, receivedAt])
}

/// Which client an error came from.
enum ClientErrorSource {
  MOBILE
  CONSOLE
}
