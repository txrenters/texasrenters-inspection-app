  inspectionMediaId String              @unique @db.Uuid
  status            TranscriptionStatus @default(PENDING)
  provider          String
  language          String?
  confidence        Float?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  inspectionMedia   InspectionMedia     @relation(fields: [inspectionMediaId], references: [id])
  segments          TranscriptSegment[]

  @@index([status])
}

model TranscriptSegment {
  id                 String           @id @default(uuid()) @db.Uuid
  transcriptionJobId String           @db.Uuid
  startSeconds       Int
  endSeconds         Int
  text               String
  confidence         Float?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  transcriptionJob   TranscriptionJob @relation(fields: [transcriptionJobId], references: [id])
}

model AiAnalysisJob {
  id                String              @id @default(uuid()) @db.Uuid
  inspectionMediaId String              @db.Uuid
  status            AiAnalysisStatus    @default(PENDING)
  provider          String
  modelId           String
  promptVersion     String
  schemaVersion     String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  inspectionMedia   InspectionMedia     @relation(fields: [inspectionMediaId], references: [id])
  findings          InspectionFinding[]

  @@index([status])
}

model InspectionFinding {
  id                     String                       @id @default(uuid()) @db.Uuid
  inspectionId           String                       @db.Uuid
  propertyAreaId         String                       @db.Uuid
  inspectionMediaId      String                       @db.Uuid
  aiAnalysisJobId        String?                      @db.Uuid
  findingType            FindingType
  category               String
  title                  String
  description            String
  baselineCondition      String
  comparisonResult       ComparisonResult
  videoTimestampStart    Int
  videoTimestampEnd      Int
  severity               Severity
  possibleResponsibility ResponsibilityClassification
  confidence             Float
  recommendedReview      String
  reviewStatus           FindingReviewStatus          @default(PENDING_REVIEW)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  inspection             Inspection                   @relation(fields: [inspectionId], references: [id])
  propertyArea           PropertyArea                 @relation(fields: [propertyAreaId], references: [id])
  inspectionMedia        InspectionMedia              @relation(fields: [inspectionMediaId], references: [id])
  aiAnalysisJob          AiAnalysisJob?               @relation(fields: [aiAnalysisJobId], references: [id])
  reviews                FindingReview[]
  photos                 InspectionPhoto[]

  @@index([inspectionId, reviewStatus])
}

model InspectionReportShare {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  inspectionId   String      @db.Uuid
  createdById    String      @db.Uuid
  token          String      @unique
  recipientEmail String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  inspection     Inspection  @relation(fields: [inspectionId], references: [id])
  createdBy      UserProfile @relation(fields: [createdById], references: [id])

  @@index([inspectionId])
}

model FindingReview {
  id          String              @id @default(uuid()) @db.Uuid
  findingId   String              @db.Uuid
  reviewerId  String              @db.Uuid
  status      FindingReviewStatus
  reason      String?
  editedValue Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  finding     InspectionFinding   @relation(fields: [findingId], references: [id])
  reviewer    UserProfile         @relation(fields: [reviewerId], references: [id])
}

/// Move-in vs move-out comparison for one move-out inspection (spec §12). External
/// links (organization, move-in/move-out inspections, reviewer) are plain FK
/// columns enforced in the migration — no Prisma relations — to avoid adding
/// back-relations across many models. The comparison is a draft until a human
/// approves it; AI may assist but never finalizes.
model InspectionComparison {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @db.Uuid
  moveOutInspectionId String                     @unique @db.Uuid
  moveInInspectionId  String                     @db.Uuid
  status              ComparisonStatus           @default(DRAFT)
  overallCondition    ComparisonClassification   @default(REQUIRES_REVIEW)
  version             Int                        @default(1)
  // DETERMINISTIC or AI_ASSISTED; records how the draft was generated.
  generator           String                     @default("DETERMINISTIC")
  requiresReviewCount Int                        @default(0)
  summary             String?
  reviewedById        String?                    @db.Uuid
  reviewedAt          DateTime?
  reviewNote          String?
  metadata            Json?
  generatedAt         DateTime                   @default(now())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  areaComparisons     InspectionAreaComparison[]

  @@index([organizationId])
  @@index([moveInInspectionId])
}

/// Per-area result within a comparison. Move-in/move-out areas are referenced by
/// catalog property-area id; either side may be null when an area exists on only
/// one inspection. Administrators can override the classification with an audit
/// trail (originalClassification + overriddenBy).
model InspectionAreaComparison {
  id                     String                    @id @default(uuid()) @db.Uuid
  comparisonId           String                    @db.Uuid
  moveInPropertyAreaId   String?                   @db.Uuid
  moveOutPropertyAreaId  String?                   @db.Uuid
  areaName               String
  floorName              String?
  classification         ComparisonClassification
  matchMethod            ComparisonMatchMethod     @default(UNMATCHED)
  matchConfidence        Float                     @default(0)
  requiresReview         Boolean                   @default(false)
  summary                String?
  originalClassification ComparisonClassification?
  overriddenById         String?                   @db.Uuid
  overriddenAt           DateTime?
  overrideReason         String?
  metadata               Json?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  comparison             InspectionComparison      @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@index([comparisonId])
}

/// Configurable charge rule (spec §13/§14). The $25 unauthorized-pet amount is
/// stored here, never hard-coded, and applies only while `isActive`.
model ChargeRule {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  code            String
  description     String?
  amount          Decimal               @db.Decimal(10, 2)
  currency        String                @default("USD")
  calculationType ChargeCalculationType @default(PER_UNIQUE_ENTITY)
  effectiveFrom   DateTime              @default(now())
  effectiveTo     DateTime?
  isActive        Boolean               @default(true)
  createdById     String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

/// A technician's raw pet observation during an occupied inspection. Evidence
/// only — the technician never determines uniqueness, authorization, or charges.
model PetObservation {
  id                    String        @id @default(uuid()) @db.Uuid
  /// Client-supplied, so a retried submission records one sighting.
  ///
  /// This is the only technician write that appends rather than sets a value:
  /// note, skip and complete all land on the same state whether applied once
  /// or twice, and media and area creation already carry keys. Without this
  /// one, a request whose response was lost would record the same animal
  /// again on retry — and a duplicate pet is a charge somebody has to argue
  /// about.
  idempotencyKey        String?       @unique
  organizationId        String        @db.Uuid
  inspectionId          String        @db.Uuid
  propertyAreaId        String?       @db.Uuid
  petCandidateId        String?       @db.Uuid
  temporaryLabel        String
  species               String
  description           String?
  characteristics       String?
  notes                 String?
  photoIds              String[]      @db.Uuid
  mediaIds              String[]      @db.Uuid
  possibleDuplicateOfId String?       @db.Uuid
  recordedById          String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  petCandidate          PetCandidate? @relation(fields: [petCandidateId], references: [id], onDelete: SetNull)

  @@index([inspectionId])
  @@index([petCandidateId])
}

/// A deduplicated unique animal grouped from one or more observations. A reviewer
/// confirms uniqueness and authorization; a charge applies only to a UNIQUE_PET
/// that is UNAUTHORIZED.
model PetCandidate {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  inspectionId        String                 @db.Uuid
  species             String
  label               String
  description         String?
  reviewStatus        PetReviewStatus        @default(PENDING_REVIEW)
  authorizationStatus PetAuthorizationStatus @default(UNKNOWN)
  observationCount    Int                    @default(0)
  reviewedById        String?                @db.Uuid
  reviewedAt          DateTime?
  reviewNote          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  observations        PetObservation[]
  charges             Charge[]

  @@index([inspectionId])
}

/// A proposed or decided charge (spec §14). Amounts are Decimal money. A charge
/// is only ever finalized (APPROVED/REJECTED/ADJUSTED/WAIVED) by a human — the
/// generator drafts, it never approves.
model Charge {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  inspectionId   String        @db.Uuid
  chargeCode     String
  description    String
  propertyAreaId String?       @db.Uuid
  findingId      String?       @db.Uuid
  petCandidateId String?       @db.Uuid
  quantity       Int           @default(1)
  unitAmount     Decimal       @db.Decimal(10, 2)
  proposedAmount Decimal       @db.Decimal(10, 2)
  approvedAmount Decimal?      @db.Decimal(10, 2)
  currency       String        @default("USD")
  status         ChargeStatus  @default(DRAFT)
  source         ChargeSource  @default(SYSTEM)
  reason         String?
  evidenceRefs   Json?
  reviewedById   String?       @db.Uuid
  reviewedAt     DateTime?
  createdById    String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  petCandidate   PetCandidate? @relation(fields: [petCandidateId], references: [id], onDelete: SetNull)

  @@index([inspectionId, status])
  @@index([petCandidateId])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorUserId    String?      @db.Uuid
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([entityType, entityId, createdAt])
}

model WebhookEvent {
  id              String                  @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  status          WebhookProcessingStatus @default(RECEIVED)
  payloadHash     String
  processedAt     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([provider, providerEventId])
}
