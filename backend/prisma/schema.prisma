/// Move-in vs move-out comparison for one move-out inspection (spec §12). External
/// links (organization, move-in/move-out inspections, reviewer) are plain FK
/// columns enforced in the migration — no Prisma relations — to avoid adding
/// back-relations across many models. The comparison is a draft until a human
/// approves it; AI may assist but never finalizes.
model InspectionComparison {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @db.Uuid
  moveOutInspectionId String                     @unique @db.Uuid
  moveInInspectionId  String                     @db.Uuid
  status              ComparisonStatus           @default(DRAFT)
  overallCondition    ComparisonClassification   @default(REQUIRES_REVIEW)
  version             Int                        @default(1)
  // DETERMINISTIC or AI_ASSISTED; records how the draft was generated.
  generator           String                     @default("DETERMINISTIC")
  requiresReviewCount Int                        @default(0)
  summary             String?
  reviewedById        String?                    @db.Uuid
  reviewedAt          DateTime?
  reviewNote          String?
  metadata            Json?
  generatedAt         DateTime                   @default(now())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  areaComparisons     InspectionAreaComparison[]

  @@index([organizationId])
  @@index([moveInInspectionId])
}

/// Per-area result within a comparison. Move-in/move-out areas are referenced by
/// catalog property-area id; either side may be null when an area exists on only
/// one inspection. Administrators can override the classification with an audit
/// trail (originalClassification + overriddenBy).
model InspectionAreaComparison {
  id                     String                    @id @default(uuid()) @db.Uuid
  comparisonId           String                    @db.Uuid
  moveInPropertyAreaId   String?                   @db.Uuid
  moveOutPropertyAreaId  String?                   @db.Uuid
  areaName               String
  floorName              String?
  classification         ComparisonClassification
