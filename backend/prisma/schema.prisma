model PropertywareBuilding {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  externalId          String
  sourceSystem        String                 @default("propertyware")
  /// Optional: Propertyware exposes buildings with no portfolio assigned, and
  /// requiring one quarantined nineteen real properties out of the whole app.
  portfolioId         String?                @db.Uuid
  externalPortfolioId String?
  idNumber            String?
  name                String
  abbreviation        String?
  propertyType        String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  country             String?
  sourceStatus        String?
  // Verified Propertyware building fields: totalArea (numeric), areaUnits
  // (e.g. "Sq Ft"), and category (e.g. "RESIDENTIAL").
  totalArea           Int?
  areaUnits           String?
  category            String?
  // Administrator override used when Propertyware provides no total area.
  manualTotalArea     Int?
  manualAreaUnit      String?
  isActive            Boolean                @default(true)
  sourceCreatedAt     DateTime?
  sourceUpdatedAt     DateTime?
  firstSyncedAt       DateTime               @default(now())
  lastSyncedAt        DateTime               @default(now())
  lastSeenAt          DateTime               @default(now())
  deactivatedAt       DateTime?

  /// Where this building is, once its address has been looked up.
  ///
  /// On the synced record rather than on `Property`, because the console's
  /// property list and its map must answer from the same table. They did not:
  /// the list reads these rows while the map read the handful of `Property`
  /// rows the inspection workflow happens to have created, so the map silently
  /// disagreed with the page beside it.
  ///
  /// Keeping it here also makes the sync the only thing that has to be right.
  /// A building deactivated in Propertyware leaves the map because the map
  /// filters on `isActive`, and a new one joins as soon as it is geocoded --
  /// no promotion step to forget, and nothing to reconcile.
  latitude            Decimal?               @db.Decimal(9, 6)
  longitude           Decimal?               @db.Decimal(9, 6)
  geocodedFor         String?
  geocodedAt          DateTime?
  geocodeSource       String?
  geocodePrecision    String?
  sourceHash          String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  portfolio           PropertywarePortfolio? @relation(fields: [portfolioId], references: [id])
  units               PropertywareUnit[]
  leases              PropertywareLease[]
  inspections         Inspection[]

  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, isActive, name])
  @@map("propertyware_buildings")
  jobberPropertyLinks    JobberPropertyLink[]
}

