model Inspection {
  id                         String                  @id @default(uuid()) @db.Uuid
  organizationId             String                  @db.Uuid
  propertyId                 String?                 @db.Uuid
  propertywareBuildingId     String?                 @db.Uuid
  propertywareUnitId         String?                 @db.Uuid
  propertywareLeaseId        String?                 @db.Uuid
  /// The Jobber visit this inspection was created from, and the job it belongs
  /// to. Null for anything booked here.
  jobberVisitId              String?
  jobberJobId                String?
  /// UNUSED, and never written. Kept only because dropping a column is a
  /// migration production also has to run.
  ///
  /// It was meant to hold Jobber's last-modified stamp for the visit, but
  /// `Visit` has no `updatedAt` field — the first live query proved that. The
  /// sync detects a reschedule by comparing `startAt`/`endAt` against
  /// `scheduledStartAt`/`scheduledEndAt` instead, which is a better signal: it
  /// fires on the change this integration exists to propagate rather than on
  /// any edit. Drop this column when there is a reason to migrate anyway.
  jobberUpdatedAt            DateTime?
  inspectionType             InspectionType
  /// Which system booked this visit.
  ///
  /// Defaults to MANUAL so every existing row keeps meaning what it meant, and
  /// so an inspection created by a path that has not thought about Jobber is
  /// never mistaken for a synced one. It gates writes: the sync may only
  /// overwrite rows it owns.
  source                     InspectionSource        @default(MANUAL)
  baselineInspectionId       String?                 @db.Uuid
  priority                   String                  @default("STANDARD")
  internalNotes              String?
  /// The report's closing block, written by the reviewer at sign-off.
  ///
  /// Three separate fields rather than one note because the office's printed
  /// report prints them as three headed columns, and they are read by
  /// different people: the alert schedules the next visit, the maintenance
  /// comments become work orders, and the general comments are what the tenant
  /// reads. Merging them would force whoever reads one to sift the other two.
  /// Why the office sent this back, shown to the technician who receives it.
  ///
  /// Stored rather than left in the audit log: an audit row is for people
  /// reconstructing what happened later, and the technician standing in the
  /// property needs to read it now. Cleared on their next submission, because
  /// by then they have acted on it.
  reopenReason               String?
  nextInspectionAlert        String?
  maintenanceComments        String?
  generalComments            String?
  createdById                String?                 @db.Uuid
  status                     InspectionStatus        @default(SCHEDULED)
  /// The day the visit is booked for. Still DATE, and still the unit of
  /// booking: the duplicate rule, every index and the technician's list all
  /// work in whole days, and nothing below changes that.
  ///
  /// It stays date-only even though Jobber sends a clock time, because a
  /// widened column would silently give every historical inspection a
  /// midnight that nobody scheduled.
  scheduledAt                DateTime                @db.Date
  /// Jobber's clock time for the visit, when there is one.
  ///
  /// Null for anything scheduled here, and null is not "no time" — it is "this
  /// visit was never given one". The technician's app therefore falls back to
  /// showing the day rather than inventing an hour. Plain DateTime, following
  /// every other instant in this schema; values are UTC.
  scheduledStartAt           DateTime?
  scheduledEndAt             DateTime?
  /// Lets the technician build the area list on site.
  ///
  /// Set when a property has no approved floor plan, which is otherwise a hard
  /// block on scheduling. The areas the technician adds are written to the
  /// property as DRAFT, so an administrator still approves what becomes the
  /// property's permanent layout — this delegates the survey, not the approval.
  allowTechnicianAreaCapture Boolean                 @default(false)
  startedAt                  DateTime?
  // Technician submission (≠ completion). Only a human administrator finalizes.
  submittedAt                DateTime?
  completedAt                DateTime?
  finalizedAt                DateTime?
  finalizedById              String?                 @db.Uuid
  // Pending-finalization / follow-up workflow (spec §11).
  completionBlockedReason    String?
  tbdReason                  String?
  followUpRequired           Boolean                 @default(false)
  followUpDueAt              DateTime?
  followUpTasks              String?
  // A follow-up inspection points back at the inspection it continues.
  parentInspectionId         String?                 @db.Uuid
  inspectionRound            Int                     @default(1)
  cancelledAt                DateTime?
  cancellationReason         String?
  propertySnapshot           Json?
  leaseSnapshot              Json?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  organization               Organization            @relation(fields: [organizationId], references: [id])
  property                   Property?               @relation(fields: [propertyId], references: [id])
  propertywareBuilding       PropertywareBuilding?   @relation(fields: [propertywareBuildingId], references: [id])
  propertywareUnit           PropertywareUnit?       @relation(fields: [propertywareUnitId], references: [id])
  propertywareLease          PropertywareLease?      @relation(fields: [propertywareLeaseId], references: [id])
  baselineInspection         Inspection?             @relation("InspectionLifecycleBaseline", fields: [baselineInspectionId], references: [id], onDelete: Restrict)
  comparisonInspections      Inspection[]            @relation("InspectionLifecycleBaseline")
  parentInspection           Inspection?             @relation("InspectionFollowUp", fields: [parentInspectionId], references: [id], onDelete: Restrict)
  followUpInspections        Inspection[]            @relation("InspectionFollowUp")
  finalizedBy                UserProfile?            @relation("InspectionFinalizedBy", fields: [finalizedById], references: [id])
  assignments                InspectionAssignment[]
  areas                      InspectionArea[]
  findings                   InspectionFinding[]
  reportShares               InspectionReportShare[]
  areaEvidenceRequests       AreaEvidenceRequest[]

  /// One inspection per Jobber visit. Postgres allows many NULLs in a unique
  /// index, so every manually booked inspection is unaffected — but a visit
  /// that syncs twice cannot become two inspections.
  @@unique([organizationId, jobberVisitId])
  /// NOT DECLARED HERE: `Inspection_scheduled_booking_key`, a partial unique
  /// index on (organization, building, unit, type, scheduledAt) WHERE status =
  /// 'SCHEDULED', with NULLS NOT DISTINCT. Prisma cannot express either a
  /// partial index or NULLS NOT DISTINCT, so it lives only in migration
  /// 202608310006_inspection_booking_unique — which explains at length why it is
  /// scoped to SCHEDULED rather than to every non-terminal status. Do not
  /// "restore" it as an @@unique here: the unscoped version breaks reopening.
  @@index([organizationId, status, scheduledAt])
  @@index([organizationId, scheduledAt(sort: Desc)])
  @@index([propertywareBuildingId, scheduledAt])
  @@index([propertywareUnitId, scheduledAt])
  @@index([baselineInspectionId])
  @@index([parentInspectionId])
  @@index([organizationId, propertywareBuildingId, propertywareUnitId, propertywareLeaseId, inspectionType, scheduledAt])
  jobberOutboundTasks        JobberOutboundTask[]
}

model PropertywarePortfolio {
