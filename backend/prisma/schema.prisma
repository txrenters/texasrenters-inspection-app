generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SYSTEM_ADMIN
  PROPERTY_ADMIN
  INSPECTION_SUPERVISOR
  INSPECTION_TECHNICIAN
  CONDITION_REVIEWER
  CHARGE_APPROVER
  PROPERTY_OWNER_READ_ONLY
}

enum FloorPlanStatus {
  UPLOADED
  PROCESSING
  REVIEW_REQUIRED
  APPROVED
  FAILED
}

enum ExtractionJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PropertyAreaStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum AreaEnvironment {
  INDOOR
  OUTDOOR
  SEMI_OUTDOOR
}

/// Which visit a checklist item is written for.
///
/// ROOM is the condition walkthrough every tenancy inspection does: doors,
/// walls, floor, lights. AIR_CONDITIONING is the equipment service an HVAC visit
/// does. Both hang off the same area and only one set is asked at a time.
enum AreaChecklistItemKind {
  ROOM
  AIR_CONDITIONING
}

enum AreaCategory {
  INDOOR_ROOM
  HALLWAY
  STAIRWAY
  CLOSET
  UTILITY
  GARAGE
  ATTIC
  BASEMENT
  BALCONY
  PATIO
  PORCH
  DRIVEWAY
  YARD
  EXTERIOR_WALL
  ROOF
  PERIMETER_FENCE
  GATE
  POOL
  SHED
  OTHER_OUTDOOR
  OTHER
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  // Technician has submitted required areas; NOT the same as COMPLETED.
  TECHNICIAN_SUBMITTED
  PROCESSING
  REVIEW_REQUIRED
  // Administrator review states before human finalization.
  UNDER_REVIEW
  TBD
  FOLLOW_UP_REQUIRED
  COMPLETED
  CANCELLED
}

enum InspectionType {
  MOVE_IN
  OCCUPIED
  BACK_TO_MARKET
  MOVE_OUT
  /// Equipment maintenance, outside the tenancy lifecycle chain.
  HVAC
  /// Off-cycle work, also outside the chain. Scoped by the property itself
  /// (roof areas, air-conditioned areas) or by the office picking the area a
  /// lockbox goes on. None of them is compared against a move-in.
  ROOF
  SUPRA_LOCKBOX_PLACEMENT
  SUPRA_LOCKBOX_REMOVAL
  AC_FILTER_DELIVERY
}

enum InspectionAreaCompletionStatus {
  PENDING
  RECORDING
  RECORDED
  UPLOADED
  COMPLETED
  SKIPPED
  FAILED
}

/// How far the bytes have got from the device to the storage provider.
///
/// Deliberately server-observable only. The device also knows "waiting for
/// network", "paused" and "retrying", but those are conditions of one phone at
/// one moment, not facts about the recording — they live in the mobile queue.
/// Writing them here would mean a technician's flight mode showing up as a
/// property of the evidence.
enum MediaUploadStatus {
  PENDING
  SESSION_CREATED
  UPLOADING
  UPLOADED
  FAILED
  CANCELLED
}

enum MediaProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum PhotoCaptureType {
  AREA_OVERVIEW
  WALL_OVERVIEW
  FINDING_CONTEXT
  FINDING_CLOSE_UP
  SUPPORTING_ANGLE
  SCALE_REFERENCE
  SERIAL_OR_LABEL
  VIDEO_FRAME_SNAPSHOT
  OTHER
  FINDING_DETAIL
  SUPPORTING_EVIDENCE
}

enum VideoRecordingType {
  PRIMARY_AREA
  ADDITIONAL_ISSUE
}

enum PhotoStorageStatus {
  PENDING
  UPLOADED
  FAILED
}

enum TranscriptionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AiProvider {
  ANTHROPIC
  OPENAI
}

enum AiCredentialStatus {
  UNVERIFIED
  VALID
  INVALID
}

enum FindingReviewStatus {
  PENDING_REVIEW
  APPROVED
  EDITED
  REJECTED
  REINSPECTION_REQUESTED
}

enum FindingType {
  POSSIBLE_NEW_DAMAGE
  EXISTING_CONDITION
  MAINTENANCE
  NO_CHANGE
}

enum ComparisonResult {
  EXISTING_CONDITION
  POSSIBLE_NEW_DAMAGE
  NO_MATERIAL_CHANGE
  NORMAL_WEAR
  OWNER_MAINTENANCE
  MISSING_EVIDENCE
  INSUFFICIENT_DATA
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

enum ResponsibilityClassification {
  TENANT_REVIEW_REQUIRED
  OWNER_REVIEW_REQUIRED
  UNDETERMINED
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  FAILED
  IGNORED_DUPLICATE
}

// Move-in vs move-out comparison (spec §12). A comparison is a draft until a
// human reviews it; AI may assist but never finalizes.
enum ComparisonStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ComparisonClassification {
  UNCHANGED
  IMPROVED
  NEW_DAMAGE
  WORSENED
  RESOLVED
  MISSING_BASELINE
  MISSING_MOVE_OUT_EVIDENCE
  NOT_COMPARABLE
  REQUIRES_REVIEW
}

// How a move-out area was matched to its move-in counterpart. Deterministic
// methods are tried before any AI assistance.
enum ComparisonMatchMethod {
  LOCAL_AREA_ID
  APPROVED_ALIAS
  NORMALIZED_NAME
  AREA_CATEGORY
  CONFIGURED_MAPPING
  AI_SUGGESTED
  MANUAL
  UNMATCHED
}

// Pet observation review (spec §13). Uniqueness/evidence is one determination;
// authorization is a separate one. A charge applies only to a UNIQUE_PET that a
// reviewer has confirmed UNAUTHORIZED.
enum PetReviewStatus {
  PENDING_REVIEW
  UNIQUE_PET
  DUPLICATE
  INSUFFICIENT_EVIDENCE
}

enum PetAuthorizationStatus {
  UNKNOWN
  AUTHORIZED
  UNAUTHORIZED
}

// Charge lifecycle (spec §14). A charge is a recommendation until a human
// approves/rejects/adjusts/waives it — AI/system never finalizes.
enum ChargeStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ADJUSTED
  WAIVED
}

enum ChargeCalculationType {
  PER_UNIQUE_ENTITY
  FLAT
  PER_UNIT
}

// Who originated a charge — kept distinct so the report can separate an AI
// suggestion from a technician observation from an administrator decision.
enum ChargeSource {
  AI_SUGGESTED
  TECHNICIAN
  SYSTEM
  ADMINISTRATOR
}

model Organization {
  id                   String                            @id @default(uuid()) @db.Uuid
  name                 String
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt
  members              OrganizationMember[]
  properties           Property[]
  inspections          Inspection[]
  auditLogs            AuditLog[]
  technicianLocations  TechnicianLocationPing[]
  aiSettings           OrganizationAiSettings?
  aiProviders          AiProviderConfiguration[]
  aiUsageEvents        AiUsageEvent[]
  roles                Role[]
  roleAssignments      UserRoleAssignment[]
  checklistItems       AreaChecklistItem[]
  checklistResponses   InspectionAreaChecklistResponse[]
  areaEvidenceRequests AreaEvidenceRequest[]
  apiClients           ApiClient[]
  apiClientKeys        ApiClientKey[]
  jobberConnection     JobberConnection?
  jobberPropertyLinks  JobberPropertyLink[]
  jobberVisitImports   JobberVisitImport[]
  jobberOutboundTasks  JobberOutboundTask[]
  inspectionImportJobs InspectionImportJob[]
  clientErrorReports   ClientErrorReport[]
}

/// Fully admin-defined RBAC role. Not seeded — an organization composes any
/// subset of the code-defined permission catalog into a named role. Permission
/// keys are validated against the catalog in application code.
model Role {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String
  description    String?
  permissions    String[]             @default([])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    UserRoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// Per-user grant of a custom Role, scoped to an organization. Effective
/// permissions are the union of every assigned role's permissions.
model UserRoleAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userProfileId  String       @db.Uuid
  roleId         String       @db.Uuid
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfile    UserProfile  @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userProfileId, roleId])
  @@index([organizationId])
  @@index([roleId])
}

model OrganizationAiSettings {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @unique @db.Uuid
  activeProvider AiProvider   @default(ANTHROPIC)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AiProviderConfiguration {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  provider           AiProvider
  modelId            String
  encryptedApiKey    String?
  credentialStatus   AiCredentialStatus @default(UNVERIFIED)
  lastValidatedAt    DateTime?
  monthlyTokenBudget Int?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([provider, credentialStatus])
}

model AiUsageEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  provider       AiProvider
  modelId        String
  operation      String
  sourceId       String?      @db.Uuid
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  totalTokens    Int          @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, createdAt])
  @@index([sourceId])
}

model UserProfile {
  id                   String                   @id @default(uuid()) @db.Uuid
  authUserId           String                   @unique
  email                String                   @unique
  displayName          String
  isActive             Boolean                  @default(true)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  memberships          OrganizationMember[]
  roleAssignments      UserRoleAssignment[]
  assignments          InspectionAssignment[]   @relation("AssignedTechnician")
  assignmentsCreated   InspectionAssignment[]   @relation("AssignmentActor")
  assignmentsEnded     InspectionAssignment[]   @relation("AssignmentEndActor")
  media                InspectionMedia[]
  reviews              FindingReview[]
  pushDevices          MobilePushDevice[]
  locationPings        TechnicianLocationPing[] @relation("TechnicianLocation")
  reportShares         InspectionReportShare[]
  createdAreas         PropertyArea[]           @relation("AreaCreatedBy")
  markerUpdatedAreas   PropertyArea[]           @relation("AreaMarkerUpdatedBy")
  areaAliases          PropertyAreaAlias[]      @relation("AreaAliasCreatedBy")
  checklistItems       AreaChecklistItem[]      @relation("ChecklistItemCreatedBy")
  photos               InspectionPhoto[]
  finalizedInspections Inspection[]             @relation("InspectionFinalizedBy")
  credential           AuthCredential?
}

/// Sign-in credentials, replacing Supabase's `auth.users`.
///
/// Separate from UserProfile on purpose. The hash must never ride along in a
/// profile read — a single `select: { … }` that forgot to exclude it, or one
/// `include`, would carry it into an API response. Keeping it in its own table
/// means only code that explicitly asks for a credential can ever see one.
///
/// `authUserId` holds the SAME value Supabase issued, so every existing
/// `UserProfile.authUserId` link and every JWT `sub` in circulation stays
/// valid. It is the foreign key as well as the identity — the profile's own
/// `authUserId` is unique, so this is a true 1:1 and the database now enforces
/// what was previously only convention across two systems.
model AuthCredential {
  id String @id @default(uuid()) @db.Uuid

  authUserId String @unique

  /// Login is by email, so this is the lookup key. Kept here rather than read
  /// through the profile: an account must be able to fail authentication
  /// without the profile being loaded at all.
  email String @unique

  /// bcrypt. Supabase's `$2a$` hashes import unchanged, so nobody is forced to
  /// reset a working password.
  passwordHash String

  /// Moved out of the JWT's `app_metadata`. Supabase's copy could only be
  /// cleared by minting a new token; here it is a column, and the two clients
  /// stop disagreeing about where to read it.
  mustChangePassword Boolean @default(false)

  /// Null until the first successful sign-in. Not security-critical — it exists
  /// so a dormant account is visible without reading the audit log.
  lastSignInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile       UserProfile              @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]
  resetTokens   AuthPasswordResetToken[]

  @@index([email])
}

/// One outstanding password-reset link.
///
/// Replaces Supabase's `generateLink({ type: 'recovery' })`, and deliberately
/// does less than it did. Supabase's token was redeemed with `verifyOtp` for a
/// full **session**, so anyone holding the email could sign in and then had to
/// be trusted to change the password. This one is exchanged for a password
/// change and nothing else — a link mailed in the clear should never be a login.
model AuthPasswordResetToken {
  id String @id @default(uuid()) @db.Uuid

  authUserId String

  /// SHA-256, same reasoning as refresh tokens: the row is a live credential
  /// until it is used, and a leaked backup must not be redeemable.
  tokenHash String @unique

  expiresAt DateTime

  /// Set the moment it is redeemed. Kept rather than deleted so a second
  /// attempt is distinguishable from a token that never existed.
  consumedAt DateTime?

  createdAt DateTime @default(now())

  credential AuthCredential @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)

  @@index([authUserId])
  @@index([expiresAt])
}

/// One issued refresh token.
///
/// Stored hashed, never in the clear: this table is a list of live sessions,
/// and a leaked backup of plaintext tokens would be as good as a leaked
/// password for every signed-in user.
///
/// Rotation is why `replacedById` exists. Each refresh issues a new token and
/// retires the old one, so a token presented after being replaced means it was
/// captured and replayed — detectable precisely because the used row is kept
/// rather than deleted.
model AuthRefreshToken {
  id String @id @default(uuid()) @db.Uuid

  authUserId String

  /// SHA-256 of the token. Unique so a replay cannot quietly create a second
  /// live session, and indexed because it is the only lookup key.
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  /// The token issued in this one's place. Set on rotation; null while live.
  replacedById String? @db.Uuid

  /// Recorded to make a stolen-token investigation possible. Deliberately not
  /// used for validation — pinning a session to an IP breaks every technician
  /// moving between cellular and site Wi-Fi.
  userAgent String?
  ipAddress String?

  /// Which handset this session belongs to, as the handset itself reports.
  ///
  /// Exists so a technician who reinstalls the app is not told they are
  /// "signed in on another device". Uninstalling never reaches the server, so
  /// the old refresh token outlives the app that owned it and the reinstall
  /// looked like a second phone for the rest of the token's thirty days.
  ///
  /// Not a security boundary, and deliberately not treated as one: the value
  /// comes from the client and could be copied. It gains an attacker nothing —
  /// they would still need the password, and with the password they could take
  /// the session over anyway. This only decides whether a person is *asked*.
  deviceId  String?

  createdAt DateTime @default(now())

  credential AuthCredential @relation(fields: [authUserId], references: [authUserId], onDelete: Cascade)

  @@index([authUserId])
  @@index([expiresAt])
}

model MobilePushDevice {
  id            String      @id @default(uuid()) @db.Uuid
  userProfileId String      @db.Uuid
  expoPushToken String      @unique
  platform      String
  isActive      Boolean     @default(true)
  lastSeenAt    DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId, isActive])
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userProfileId  String       @db.Uuid
  role           UserRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  userProfile    UserProfile  @relation(fields: [userProfileId], references: [id])

  @@unique([organizationId, userProfileId, role])
}

model Property {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  name           String
  addressLine1   String
  city           String
  state          String               @default("TX")
  postalCode     String

  /// Where this property actually is, once its address has been looked up.
  ///
  /// `Decimal(9, 6)` — roughly 11cm — and unlike the `Decimal(6, 5)` used for
  /// floor-plan markers it can hold a Texas longitude, which needs two digits
  /// before the point. Null until the geocoder has run: nothing in the sync
  /// supplies coordinates, because Propertyware sends none.
  latitude         Decimal?  @db.Decimal(9, 6)
  longitude        Decimal?  @db.Decimal(9, 6)

  /// The address string these coordinates were derived from.
  ///
  /// Kept so that an edited address can be *noticed*. Without it a property
  /// that moved from one street to another would keep its old pin for ever,
  /// and a wrong pin is worse than no pin — it sends somebody to the wrong door.
  geocodedFor      String?
  geocodedAt       DateTime?

  /// Which service answered, and how precisely.
  ///
  /// Precision is stored because a ZIP-code centroid and a street match are
  /// very different claims. Drawing them identically would have the map assert
  /// something nobody knows, so the console is told and decides.
  geocodeSource    String?
  geocodePrecision String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id])
  floorPlans     PropertyFloorPlan[]
  floors         PropertyFloor[]
  areas          PropertyArea[]
  inspections    Inspection[]
  baselines      BaselineInspection[]
}

model PropertyFloorPlan {
  id             String                   @id @default(uuid()) @db.Uuid
  propertyId     String                   @db.Uuid
  // Null = plan for the whole building (single-family or shared layout).
  // Set = plan for one specific unit of a multi-unit building.
  unitId         String?                  @db.Uuid
  fileName       String
  mimeType       String
  storageKey     String
  sizeBytes      Int
  status         FloorPlanStatus          @default(UPLOADED)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  property       Property                 @relation(fields: [propertyId], references: [id])
  unit           PropertywareUnit?        @relation("UnitFloorPlans", fields: [unitId], references: [id], onDelete: Restrict)
  extractionJobs FloorPlanExtractionJob[]
  // Areas whose marker coordinates belong to this specific plan version.
  markedAreas    PropertyArea[]           @relation("AreaSourceFloorPlan")

  @@index([propertyId, unitId])
}

/// Reading an inspection report PDF, which outlives the request that asked for it.
///
/// A 48-page report with 376 photographs takes longer than a browser will wait,
/// and the work must not die with the connection — the same reason floor-plan
/// extraction was moved out of its request. The row is what the console polls,
/// and what lets somebody close the tab and come back to the answer.
model InspectionImportJob {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  /// The Propertyware building the report describes.
  buildingId     String              @db.Uuid
  /// Content hash of the uploaded PDF. Two jobs for one file is a double
  /// import, which would silently become the baseline every move-out is
  /// judged against.
  fingerprint    String
  status         ExtractionJobStatus @default(PENDING)
  /// Where the parsed report came from: DETERMINISTIC when the layout was
  /// recognised, AI when it was not, so a reader can tell which answers were
  /// measured and which were inferred.
  method         String              @default("DETERMINISTIC")
  provider       String?
  modelId        String?
  /// The parsed report, for the preview the console shows before committing.
  output         Json?
  errorCode      String?
  /// The inspection this report is being read for. Set when the job starts,
  /// because a report is always imported *into* an existing record — Jobber
  /// creates the move-in when the visit completes, and the walkthrough itself
  /// happened in another system.
  inspectionId   String?             @db.Uuid
  /// Set once the evidence has actually been written, so a finished reading and
  /// a finished import are never confused for each other.
  committedAt    DateTime?
  startedById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([organizationId, fingerprint])
}

model FloorPlanExtractionJob {
  id            String              @id @default(uuid()) @db.Uuid
  floorPlanId   String              @db.Uuid
  status        ExtractionJobStatus @default(PENDING)
  provider      String
  modelId       String
  schemaVersion String
  output        Json?
  errorCode     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  floorPlan     PropertyFloorPlan   @relation(fields: [floorPlanId], references: [id])

  @@index([status])
}

model PropertyFloor {
  id         String            @id @default(uuid()) @db.Uuid
  propertyId String            @db.Uuid
  unitId     String?           @db.Uuid
  name       String
  sortOrder  Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  property   Property          @relation(fields: [propertyId], references: [id])
  unit       PropertywareUnit? @relation("UnitFloors", fields: [unitId], references: [id], onDelete: Restrict)
  areas      PropertyArea[]

  // The database index is created NULLS NOT DISTINCT so building-level floor
  // names (unitId null) stay unique among themselves.
  @@unique([propertyId, unitId, name])
}

model PropertyArea {
  id                 String                  @id @default(uuid()) @db.Uuid
  propertyId         String                  @db.Uuid
  unitId             String?                 @db.Uuid
  floorId            String?                 @db.Uuid
  name               String
  inspectionOrder    Int
  isRequired         Boolean                 @default(true)
  status             PropertyAreaStatus      @default(DRAFT)
  // Provenance: AI_FLOOR_PLAN | MANUAL | MANUAL_FALLBACK (admin) | TECHNICIAN.
  source             String                  @default("MANUAL")
  // Indoor/outdoor classification and a finer category for outdoor targets.
  environment        AreaEnvironment         @default(INDOOR)
  category           AreaCategory?
  notes              String?
  createdById        String?                 @db.Uuid
  // Soft archive; archived areas drop out of active lists but retain media.
  archivedAt         DateTime?
  // Spatial marker (normalized 0..1 relative to the source image/page). Nullable:
  // legacy/manual areas may have no marker. Coordinates belong to a specific plan
  // version (sourceFloorPlanId) so a replaced plan never silently reuses them.
  markerX            Decimal?                @db.Decimal(6, 5)
  markerY            Decimal?                @db.Decimal(6, 5)
  // AI_EXTRACTED | DETERMINISTIC_EXTRACTED | ADMIN_ADJUSTED | ADMIN_PLACED | UNKNOWN
  markerSource       String?
  markerConfidence   Decimal?                @db.Decimal(4, 3)
  markerUpdatedById  String?                 @db.Uuid
  markerUpdatedAt    DateTime?
  sourceFloorPlanId  String?                 @db.Uuid
  sourcePageNumber   Int?
  // Optional normalized bounding box (extensible; unused for point markers).
  boundingBoxX       Decimal?                @db.Decimal(6, 5)
  boundingBoxY       Decimal?                @db.Decimal(6, 5)
  boundingBoxWidth   Decimal?                @db.Decimal(6, 5)
  boundingBoxHeight  Decimal?                @db.Decimal(6, 5)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  property           Property                @relation(fields: [propertyId], references: [id])
  unit               PropertywareUnit?       @relation("UnitAreas", fields: [unitId], references: [id], onDelete: Restrict)
  floor              PropertyFloor?          @relation(fields: [floorId], references: [id])
  createdBy          UserProfile?            @relation("AreaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  markerUpdatedBy    UserProfile?            @relation("AreaMarkerUpdatedBy", fields: [markerUpdatedById], references: [id], onDelete: SetNull)
  sourceFloorPlan    PropertyFloorPlan?      @relation("AreaSourceFloorPlan", fields: [sourceFloorPlanId], references: [id], onDelete: SetNull)
  inspectionAreas    InspectionArea[]
  baselineConditions BaselineAreaCondition[]
  findings           InspectionFinding[]
  aliases            PropertyAreaAlias[]
  checklistItems     AreaChecklistItem[]

  // The database index is created NULLS NOT DISTINCT so building-level areas
  // (unitId null) stay unique among themselves.
  @@unique([propertyId, unitId, floorId, name])
  @@index([propertyId, unitId, floorId, inspectionOrder])
}

/// Prior/alternate names for an area (rename and merge history). Used to keep
/// evidence associated after a rename and to match areas during move-in vs
/// move-out comparison.
/// An item the technician is expected to cover while recording this area.
///
/// Authored by an administrator per area. Ticking is the technician's own
/// record of coverage — it never gates completing an area, because the
/// walkthrough video remains the evidence and an untouched checkbox is not
/// proof that something was missed.
enum EvidenceRequestStatus {
  OPEN
  RESOLVED
  CANCELLED
}

/// A reviewer asking the technician for more evidence in one specific area.
///
/// Targeted on purpose. The office could already send an inspection back, but
/// only as a whole — the technician saw a job reappear in their queue with no
/// statement of what was missing, so the round trip depended on someone
/// phoning them. This names the area, optionally the exact checklist items,
/// and what is needed.
///
/// `checklistItemIds` empty means the whole area. It is a plain uuid array
/// rather than a join table because the list is small, always read with its
/// parent, and never queried from the other side; the ids are validated
/// against the area's own checklist when the request is created.
model AreaEvidenceRequest {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  inspectionId     String                @db.Uuid
  inspectionAreaId String                @db.Uuid
  checklistItemIds String[]              @default([]) @db.Uuid
  note             String
  status           EvidenceRequestStatus @default(OPEN)
  requestedById    String                @db.Uuid
  requestedAt      DateTime              @default(now())
  resolvedById     String?               @db.Uuid
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  organization     Organization          @relation(fields: [organizationId], references: [id])
  inspection       Inspection            @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionArea   InspectionArea        @relation(fields: [inspectionAreaId], references: [id], onDelete: Cascade)

  @@index([inspectionId, status])
  @@index([inspectionAreaId])
  @@index([organizationId])
}

/// One item's condition, as assessed during a specific inspection.
///
/// The three axes mirror the printed report the office already issues: every
/// row is scored Clean / Undamaged / Working, with a comment for anything that
/// needs words. They are **nullable on purpose** — the existing reports leave
/// rows blank, and "not assessed" is a different claim from "No". Collapsing
/// the two would invent findings nobody made.
///
/// Keyed to InspectionArea rather than PropertyArea: the same room is assessed
/// again at every inspection, and last quarter's answers must not appear as
/// this quarter's.
model InspectionAreaChecklistResponse {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @db.Uuid
  inspectionAreaId      String            @db.Uuid
  checklistItemId       String            @db.Uuid
  isClean               Boolean?
  isUndamaged           Boolean?
  isWorking             Boolean?
  comment               String?
  /// Seconds into the area's recording when this was answered, so a reviewer can
  /// jump straight to the moment rather than scrubbing an hour of video. Null for
  /// an assessment made outside a recording — the web review screen, or a
  /// technician scoring after the fact.
  videoTimestampSeconds Int?
  recordedById          String?           @db.Uuid
  recordedAt            DateTime          @default(now())
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  organization          Organization      @relation(fields: [organizationId], references: [id])
  inspectionArea        InspectionArea    @relation(fields: [inspectionAreaId], references: [id], onDelete: Cascade)
  checklistItem         AreaChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)

  /// One assessment per item per area. Re-scoring updates it rather than
  /// stacking a second opinion the report would have to choose between.
  @@unique([inspectionAreaId, checklistItemId])
  @@index([inspectionAreaId])
  @@index([organizationId])
}

model AreaChecklistItem {
  id               String                            @id @default(uuid()) @db.Uuid
  organizationId   String                            @db.Uuid
  /// The area these items belong to, or null for an organization-wide list.
  ///
  /// Room checklists are written per area, because the question depends on the
  /// room. The HVAC checklist is not: it is one standard list about the
  /// property's system, identical everywhere, and storing it per area would
  /// mean copying the same rows onto every property in the portfolio and
  /// keeping ~570 copies in step whenever a line changes.
  propertyAreaId   String?                           @db.Uuid
  label            String
  /// What kind of inspection this item belongs to.
  ///
  /// Items are stored per *area*, but a given area is walked differently
  /// depending on the visit: a move-in asks about its floor and its walls, an
  /// HVAC visit asks about the air conditioner hanging in it. A response points
  /// at a persisted item row, so the two sets have to coexist on the area rather
  /// than one being generated on the fly. This is what separates them.
  kind             AreaChecklistItemKind             @default(ROOM)
  /// Spoken words that count as covering this item, matched against the
  /// recording's transcript. Empty means the item can only be ticked by hand.
  keywords         String[]                          @default([])
  sortOrder        Int                               @default(0)
  archivedAt       DateTime?
  createdById      String?                           @db.Uuid
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  organization     Organization                      @relation(fields: [organizationId], references: [id])
  propertyArea     PropertyArea?                     @relation(fields: [propertyAreaId], references: [id], onDelete: Cascade)
  createdBy        UserProfile?                      @relation("ChecklistItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  responses        InspectionAreaChecklistResponse[]
  inspectionPhotos InspectionPhoto[]

  /// The same wording twice in one area *of the same kind* is a mistake, not a
  /// second item. Across kinds it is legitimate and expected: an area can
  /// reasonably be asked about its vents as part of the room and again as part
  /// of the air conditioner.
  ///
  /// This covers per-area rows only. Postgres treats NULLs as distinct, so it
  /// does not constrain the organization-wide rows at all — those are covered
  /// by a partial unique index created in raw SQL, which Prisma cannot express.
  @@unique([propertyAreaId, kind, label])
  @@index([propertyAreaId, sortOrder])
  @@index([organizationId])
}

model PropertyAreaAlias {
