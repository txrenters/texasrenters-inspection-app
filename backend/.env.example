NODE_ENV=development
PORT=3000
# The host is the Compose service name, not localhost: inside the backend
# container localhost is the backend itself. DIRECT_URL is the unpooled
# connection Prisma migrations use and is normally the same address.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/texasrenters?schema=public
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/texasrenters?schema=public
# Applied to whatever DATABASE_URL holds, unless the URL states its own.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_WARMUP_ENABLED=true
SLOW_QUERY_WARNING_MS=250
SLOW_REQUEST_WARNING_MS=750
CACHE_ENABLED=true
CACHE_PROVIDER=redis
CACHE_KEY_PREFIX=texasrenters
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_TTL_JITTER_PERCENT=15
CACHE_SINGLE_FLIGHT_ENABLED=true
CACHE_METRICS_ENABLED=true
CACHE_FAIL_OPEN=true
CACHE_MAX_VALUE_BYTES=262144
HTTP_REQUEST_TIMEOUT_MS=30000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5454,http://localhost:5456,http://localhost:8081,http://localhost:8082,http://localhost:19006
MOBILE_APP_ORIGIN=http://localhost:8082
WEB_APP_ORIGIN=http://localhost:5454
# Microsoft Graph app-only mail. Grant the Entra app the Mail.Send application
# permission with admin consent. No mailbox password is stored.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MAIL_FROM_ADDRESS=
MAIL_CONNECTION_TIMEOUT_MS=10000
# Administrative seed. Keep the password in .env.local only.
SEED_SUPER_ADMIN_EMAIL=appdev@texasrenters.com
SEED_SUPER_ADMIN_LEGACY_EMAILS=appdev@texasrenters.wom
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_RESET_PASSWORD=false
SEED_SUPER_ADMIN_DISPLAY_NAME=TexasRenters Super Admin
SEED_SUPER_ADMIN_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
SEED_SUPER_ADMIN_ORGANIZATION_NAME=TexasRenters Development
# Cloudflare Stream. Backend-only, every one of them — the API token can create
# and delete video in the account, and the signing key mints playback
# credentials for any inspection. Never copy these into an NEXT_PUBLIC_* or
# EXPO_PUBLIC_* variable: those prefixes ship their value to every device.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# Where Cloudflare sends processing notifications. Must be publicly reachable —
# Cloudflare cannot call localhost or a private LAN address, so local testing
# needs the project's tunnel. Re-register when this changes.
CLOUDFLARE_STREAM_WEBHOOK_URL=https://api.texasrenters.com/api/v1/webhooks/cloudflare-stream
# Returned by Cloudflare when the webhook is registered. Obtain it with
# `npm run stream:webhook --workspace @texasrenters/backend` and paste it here; it is
# never written to a file automatically.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# The `customer-<code>` subdomain that serves manifests for this account.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Signed playback. Inspection video is evidence about someone's home and is
# created with requireSignedURLs, so without these it cannot be played at all.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
# Transcription. Setting this makes Deepgram the transcription provider for
# every room recording; leaving it blank falls back to OpenAI using the key from
# Settings → AI operations.
#
# Deepgram is preferred because it returns per-utterance timestamps — without
# them the whole narration is stored as one segment spanning the video, and the
# timestamp on every AI finding is a guess. It also handles accented and
# non-native narration better, which is what this crew records.
#
# Transcription only. The findings summary is still written by the
# organization's AI provider below.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_CREDENTIALS_ENCRYPTION_KEY=
TRANSCRIPTION_API_KEY=
REDIS_URL=redis://localhost:6379
# Use REDIS_HOST/PORT/USERNAME/PASSWORD instead of REDIS_URL only when required by the provider.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
SENTRY_DSN=
FLOOR_PLAN_EXTRACTION_PROVIDER=disabled
ANTHROPIC_FLOOR_PLAN_MODEL=
OPENAI_FLOOR_PLAN_MODEL=
# These four are validated at boot and then read by nothing. They are left in
# place only so an existing .env.local does not fail validation — changing any
# of them has no effect on behaviour, and setting them to a real provider will
# NOT switch anything on.
#
# What actually decides each one:
#   video upload      — Cloudflare Stream when CLOUDFLARE_* is set, else R2
#   transcription     — OpenAI key in Settings → AI operations (a database
#                       record, not an environment variable)
#   AI analysis       — the organization's active provider, same screen
#   job queue         — in-process; there is no queue backend to select
VIDEO_PLATFORM_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
AI_ANALYSIS_PROVIDER=mock
JOB_QUEUE_PROVIDER=memory
# Object storage backends: local | supabase | r2.
# WARNING: `local` writes to the container's disk, which is ephemeral — every
# upload is lost on redeploy. Use it for development only.
FLOOR_PLAN_STORAGE_PROVIDER=local
FLOOR_PLAN_STORAGE_BUCKET=floor-plans
INSPECTION_MEDIA_STORAGE_PROVIDER=local
INSPECTION_MEDIA_STORAGE_BUCKET=inspection-media
# Cloudflare R2 (S3-compatible), required when either provider above is `r2`.
# Create under R2 > Manage R2 API Tokens with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# HMAC-SHA256 secret for provider webhook callbacks (x-webhook-signature).
# Required in production; unsigned webhooks are only accepted in development.
WEBHOOK_SIGNING_SECRET=

# Propertyware is read-only in this phase. Mock + memory is the safe local default.
PROPERTYWARE_PROVIDER=mock
PROPERTYWARE_STORE=memory
PROPERTYWARE_BASE_URL=https://api.propertyware.com/pw/api/rest/v1
PROPERTYWARE_CLIENT_ID=
PROPERTYWARE_CLIENT_SECRET=
PROPERTYWARE_ORGANIZATION_ID=
# Optional temporary fallback when the official portfolio endpoints are denied.
# Treat this opaque report URL as a secret and keep it in .env.local only.
PROPERTYWARE_PORTFOLIO_REPORT_URL=
PROPERTYWARE_REQUEST_TIMEOUT_MS=30000
PROPERTYWARE_PAGE_SIZE=500
PROPERTYWARE_MAX_RETRIES=4
# Automatic syncs run only when this is "true" AND PROPERTYWARE_LOCAL_ORGANIZATION_ID is set.
PROPERTYWARE_SYNC_ENABLED=false
# Internal organization UUID the scheduled syncs run for.
PROPERTYWARE_LOCAL_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
# Incremental sync cadence (delta pull). Every 24 hours (daily at 00:00).
PROPERTYWARE_INCREMENTAL_SYNC_CRON=0 0 * * *
# Full reconciliation: every 24 hours (daily at 02:00). Monthly would be "0 2 1 * *".
PROPERTYWARE_RECONCILIATION_CRON=0 2 * * *
PROPERTYWARE_INITIAL_SYNC_LOOKBACK_DAYS=30
PROPERTYWARE_CURSOR_OVERLAP_SECONDS=120
PROPERTYWARE_DATABASE_CONCURRENCY=4
PROPERTYWARE_DATABASE_BATCH_SIZE=50

# Report letterhead, printed at the head and foot of every shared report.
# Read at request time, so a change takes effect on the next report.
REPORT_BRAND_NAME=
REPORT_BRAND_ADDRESS_LINE1=
REPORT_BRAND_ADDRESS_LINE2=
REPORT_BRAND_PHONE=
REPORT_BRAND_EMAIL=

# The office's own name for each inspection form, shown as "Inspection
# Template" on the report. Each falls back to a label derived from the enum.
REPORT_TEMPLATE_LABEL_MOVE_IN=
REPORT_TEMPLATE_LABEL_MOVE_OUT=
REPORT_TEMPLATE_LABEL_OCCUPIED=
REPORT_TEMPLATE_LABEL_BACK_TO_MARKET=
REPORT_TEMPLATE_LABEL_HVAC=
