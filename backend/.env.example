NODE_ENV=development
PORT=3000
# Use the transaction pooler on 6543 for runtime traffic; reserve DIRECT_URL for migrations.
# Copy the exact project-specific values from Supabase Dashboard > Connect > ORM > Prisma.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@POOLER_HOST:5432/postgres
# Keep this backend within Supabase's session-pool connection budget.
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_WARMUP_ENABLED=true
SLOW_QUERY_WARNING_MS=250
SLOW_REQUEST_WARNING_MS=750
CACHE_ENABLED=true
CACHE_PROVIDER=redis
CACHE_KEY_PREFIX=texasrenters
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_TTL_JITTER_PERCENT=15
CACHE_SINGLE_FLIGHT_ENABLED=true
CACHE_METRICS_ENABLED=true
CACHE_FAIL_OPEN=true
CACHE_MAX_VALUE_BYTES=262144
HTTP_REQUEST_TIMEOUT_MS=30000
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5454,http://localhost:8081,http://localhost:19006
MOBILE_APP_ORIGIN=http://localhost:8081
WEB_APP_ORIGIN=http://localhost:5454
USE_MOCK_AUTH=false
# Must match a MOCK_USERS id (see src/common/auth.ts); -002 System Admin, -004 Technician.
MOCK_AUTH_DEFAULT_USER_ID=10000000-0000-4000-8000-000000000002
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Development-only administrative seed. Keep the password in .env.local only.
SEED_SUPER_ADMIN_EMAIL=appdev@texasrenters.com
SEED_SUPER_ADMIN_LEGACY_EMAILS=appdev@texasrenters.wom
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_RESET_PASSWORD=false
SEED_SUPER_ADMIN_DISPLAY_NAME=TexasRenters Super Admin
SEED_SUPER_ADMIN_ORGANIZATION_ID=10000000-0000-4000-8000-000000000001
SEED_SUPER_ADMIN_ORGANIZATION_NAME=TexasRenters Development
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_CREDENTIALS_ENCRYPTION_KEY=
TRANSCRIPTION_API_KEY=
REDIS_URL=redis://localhost:6379
# Use REDIS_HOST/PORT/USERNAME/PASSWORD instead of REDIS_URL only when required by the provider.
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
SENTRY_DSN=
FLOOR_PLAN_EXTRACTION_PROVIDER=disabled
ANTHROPIC_FLOOR_PLAN_MODEL=
OPENAI_FLOOR_PLAN_MODEL=
VIDEO_PLATFORM_PROVIDER=mock
TRANSCRIPTION_PROVIDER=mock
AI_ANALYSIS_PROVIDER=mock
JOB_QUEUE_PROVIDER=memory
FLOOR_PLAN_STORAGE_PROVIDER=local
FLOOR_PLAN_STORAGE_BUCKET=floor-plans
# Room-video storage for the technician upload endpoint: local disk by default,
# or the Supabase storage bucket when set to supabase.
INSPECTION_MEDIA_STORAGE_PROVIDER=local
INSPECTION_MEDIA_STORAGE_BUCKET=inspection-media
# HMAC-SHA256 secret for provider webhook callbacks (x-webhook-signature).
# Required in production; unsigned webhooks are only accepted in development.
WEBHOOK_SIGNING_SECRET=

# Propertyware is read-only in this phase. Mock + memory is the safe local default.
PROPERTYWARE_PROVIDER=mock
PROPERTYWARE_STORE=memory
PROPERTYWARE_BASE_URL=https://api.propertyware.com/pw/api/rest/v1
PROPERTYWARE_CLIENT_ID=
PROPERTYWARE_CLIENT_SECRET=
PROPERTYWARE_ORGANIZATION_ID=
# Optional temporary fallback when the official portfolio endpoints are denied.
# Treat this opaque report URL as a secret and keep it in .env.local only.
PROPERTYWARE_PORTFOLIO_REPORT_URL=
PROPERTYWARE_REQUEST_TIMEOUT_MS=30000
PROPERTYWARE_PAGE_SIZE=500
PROPERTYWARE_MAX_RETRIES=4
PROPERTYWARE_SYNC_ENABLED=false
# Example schedules only; production frequency requires operational approval.
PROPERTYWARE_INCREMENTAL_SYNC_CRON=0 */4 * * *
PROPERTYWARE_RECONCILIATION_CRON=0 2 * * *
PROPERTYWARE_INITIAL_SYNC_LOOKBACK_DAYS=30
PROPERTYWARE_CURSOR_OVERLAP_SECONDS=120
PROPERTYWARE_DATABASE_CONCURRENCY=4
PROPERTYWARE_DATABASE_BATCH_SIZE=50
