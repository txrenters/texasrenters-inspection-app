{
  "name": "@texasrenters/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @texasrenters/shared build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @texasrenters/shared build",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma/*.ts",
    "pretypecheck": "pnpm --filter @texasrenters/shared build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @texasrenters/shared build",
    "test": "jest --runInBand",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "perf:database": "node --env-file-if-exists=.env.local scripts/perf-database.mjs",
    "perf:database:session": "node --env-file-if-exists=.env.local scripts/perf-database.mjs --session",
    "perf:endpoints": "node scripts/perf-endpoints.mjs",
    "perf:backend": "pnpm perf:endpoints",
    "perf:query-plans": "node --env-file-if-exists=.env.local scripts/perf-query-plans.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:super-admin": "node --env-file-if-exists=.env.local -r ts-node/register/transpile-only prisma/seed-super-admin.ts",
    "propertyware:sync:mock": "ts-node src/integrations/propertyware/propertyware.cli.ts initial mock",
    "propertyware:reconcile:mock": "ts-node src/integrations/propertyware/propertyware.cli.ts reconcile mock",
    "propertyware:sync:live": "ts-node src/integrations/propertyware/propertyware.cli.ts initial live",
    "propertyware:status": "ts-node src/integrations/propertyware/propertyware.cli.ts status db",
    "propertyware:sync:dry-run": "ts-node src/integrations/propertyware/propertyware.cli.ts dry-run live",
    "propertyware:sync:buildings:dry-run": "ts-node src/integrations/propertyware/propertyware.cli.ts dry-run live portfolios,buildings",
    "propertyware:sync:initial": "ts-node src/integrations/propertyware/propertyware.cli.ts initial live",
    "propertyware:sync:buildings:initial": "ts-node src/integrations/propertyware/propertyware.cli.ts initial live portfolios,buildings",
    "propertyware:reconcile:buildings": "ts-node src/integrations/propertyware/propertyware.cli.ts reconcile live portfolios,buildings",
    "propertyware:sync:incremental": "ts-node src/integrations/propertyware/propertyware.cli.ts incremental live",
    "propertyware:reconcile": "ts-node src/integrations/propertyware/propertyware.cli.ts reconcile live",
    "propertyware:verify:db": "ts-node src/integrations/propertyware/propertyware.cli.ts verify-db",
    "stream:webhook": "node --env-file-if-exists=.env.local scripts/configure-cloudflare-stream-webhook.mjs",
    "db:reset-inspections": "node --env-file-if-exists=.env.local scripts/reset-inspection-data.mjs",
    "db:migrate-to-local": "node --env-file-if-exists=.env.local scripts/migrate-to-local-postgres.mjs",
    "db:import-credentials": "node --env-file-if-exists=.env.local scripts/import-supabase-credentials.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/platform-socket.io": "11.1.28",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "11.1.28",
    "@prisma/client": "6.19.0",
    "@supabase/supabase-js": "^2.110.7",
    "@texasrenters/shared": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "compression": "^1.8.1",
    "cron": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.16",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "11.1.28",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.12.0",
    "@types/supertest": "^7.2.0",
    "jest": "29.7.0",
    "prisma": "6.19.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "node --env-file-if-exists=.env.local -r ts-node/register/transpile-only prisma/seed.ts"
  }
}
