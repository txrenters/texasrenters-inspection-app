# Staging environment — the production stack, run locally, before shipping.
#
#   cp .env.staging.example .env.staging
#   # generate the two secrets below, then:
#   npm run staging:build && npm run staging:up
#
# Add to your hosts file first, or nothing resolves:
#   127.0.0.1 inspection.texasrenters.com inspection-api.texasrenters.com
#
# Throwaway values are fine here and none of them may be reused in
# production. What must stay identical to production is the shape: the same
# hostnames, the same two origins, the same build arg.
#
#   cp .env.production.example .env.production
#   # fill in every empty value below
#   npm run prod:up
#
# Same shape as .env.development.example. What differs is marked: the hostnames,
# the database credentials, and the fact that nothing here has a working
# default. An empty required value fails at boot, which is the intent — a
# production stack that starts with a development secret is worse than one that
# refuses to start.
#
# `.env.production` is gitignored. This example is not: it must never hold a
# real credential.

# -----------------------------------------------------------------------------
# Identity
#
# A distinct project name, so a production stack can never adopt the volumes or
# containers of a development one sharing a host.
# -----------------------------------------------------------------------------
NODE_ENV=production
COMPOSE_PROJECT_NAME=texasrenters-staging
# Which file the containers read their environment from. Compose interpolates
# this from --env-file before any service starts.
APP_ENV_FILE=./.env.staging

# -----------------------------------------------------------------------------
# Hostnames
#
# Both names resolve to this VPS and terminate at the reverse proxy. The API
# host must also pass WebSocket upgrades: the technician event stream is
# Socket.IO on /technician-events with no polling fallback, so without it the
# REST API works and live updates silently do not.
# -----------------------------------------------------------------------------
BACKEND_PORT=3000
WEB_PORT=5454

# The two names Caddy answers on and obtains certificates for. Bare hostnames,
# not URLs — they are the site addresses in the Caddyfile. They must match the
# origins below, and their DNS must be DNS-only (grey cloud): certificates are
# issued over HTTP-01 on port 80, which has to reach this server.
WEB_HOST=inspection.texasrenters.com
API_HOST=inspection-api.texasrenters.com
# Where Let's Encrypt sends expiry warnings. Set it to a mailbox somebody reads:
# it is the only notice you get that renewal has started failing.
# Unused here: Caddyfile.local issues from Caddy's own CA and registers no
# ACME account. Present because the production compose file declares it.
ACME_EMAIL=staging@localhost

# Browser -> backend. A BUILD ARG, inlined into the JavaScript bundle: a web
# image is permanently pinned to whatever this said when it was built. Set it
# before building the release image, not after.
NEXT_PUBLIC_API_BASE_URL=https://inspection-api.texasrenters.com
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Console server -> backend, container to container. Never a public URL: this
# traffic should not leave the box and back.
API_INTERNAL_BASE_URL=http://backend:3000

# Backend -> the console. WEB_APP_ORIGIN also builds every shared-report link
# the backend emails, so a wrong value produces links that go nowhere without
# erroring anywhere.
WEB_APP_ORIGIN=https://inspection.texasrenters.com
MOBILE_APP_ORIGIN=https://inspection.texasrenters.com
# NODE_ENV=production skips the built-in development origins entirely, so
# anything absent here is refused. The browser reports that as a missing
# Access-Control-Allow-Origin, which reads like a backend fault.
CORS_ALLOWED_ORIGINS=https://inspection.texasrenters.com

# -----------------------------------------------------------------------------
# Database — its own instance, its own credentials, its own volume
#
# Same Postgres service as development, pointed at a separate volume by the
# production overlay. Nothing is shared with the development database and the
# port is not published: reach it with `docker compose exec postgres psql`.
#
# Set POSTGRES_PASSWORD and use the same value in both URLs. The host is the
# Compose service name — `localhost` inside the backend container is the
# backend.
# -----------------------------------------------------------------------------
POSTGRES_DB=texasrenters
POSTGRES_USER=texasrenters
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://texasrenters:CHANGE_ME@postgres:5432/texasrenters?schema=public
DIRECT_URL=postgresql://texasrenters:CHANGE_ME@postgres:5432/texasrenters?schema=public
# Applied to the URL above unless it states its own. Raise with the VPS's
# max_connections, not independently of it.
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_WARMUP_ENABLED=true
RLS_TENANT_SCOPE_ENABLED=true

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
CACHE_ENABLED=true
CACHE_PROVIDER=redis
# Serve from the database when Redis is unreachable rather than failing the
# request. A cache outage should degrade the site, not close it.
CACHE_FAIL_OPEN=true

# -----------------------------------------------------------------------------
# Credentials — production values, none shared with development
#
# Generate the two secrets fresh; do not carry the development ones across.
#   AUTH_JWT_SECRET             openssl rand -base64 48
#   AI_CREDENTIALS_ENCRYPTION_KEY   openssl rand -base64 32
#
# None of these may be copied into a NEXT_PUBLIC_* or EXPO_PUBLIC_* variable:
# those prefixes ship their value to every device.
# -----------------------------------------------------------------------------
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=https://inspection-api.texasrenters.com
AUTH_JWT_AUDIENCE=authenticated
AI_CREDENTIALS_ENCRYPTION_KEY=
WEBHOOK_SIGNING_SECRET=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# One webhook URL per Cloudflare account. Pointing it here removes it from
# development — plan a second account if both environments need callbacks.
# Deliberately empty. Cloudflare allows ONE webhook URL per account, so a
# staging value silently takes it from whichever environment had it.
CLOUDFLARE_STREAM_WEBHOOK_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
INSPECTION_MEDIA_STORAGE_PROVIDER=r2
# A separate bucket from development. Sharing one means a development wipe
# takes production evidence with it.
INSPECTION_MEDIA_STORAGE_BUCKET=
FLOOR_PLAN_STORAGE_PROVIDER=r2
FLOOR_PLAN_STORAGE_BUCKET=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRANSCRIPTION_API_KEY=

MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com
MAIL_FROM_ADDRESS=

# NODE_ENV=production refuses the mock fixtures outright, so the provider has
# to be 'live' and all three credentials have to be present. These are
# deliberately invalid: with sync disabled nothing calls out, and if anything
# ever did it fails authentication rather than reaching real portfolios.
PROPERTYWARE_PROVIDER=live
PROPERTYWARE_STORE=prisma
PROPERTYWARE_CLIENT_ID=staging-invalid-credential
PROPERTYWARE_CLIENT_SECRET=staging-invalid-credential
PROPERTYWARE_BASE_URL=https://api.propertyware.com/pw/api/rest/v1
# Off in staging. Live sync would pull real portfolios into a throwaway
# database, and the reconcile job writes back.
PROPERTYWARE_SYNC_ENABLED=false
PROPERTYWARE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000000

# -----------------------------------------------------------------------------
# First administrator
#
# Read only by `docker compose ... run --rm bootstrap-admin`, which creates the
# first account on an empty database and refuses once any user exists.
#
# The SEED_SUPER_ADMIN_* variables that used to sit here did nothing: that seed
# is a development tool and refuses outright when NODE_ENV is production.
#
# The password is replaced at first sign-in — every role-protected route is
# closed until it is — so clear it from this file once that is done.
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_ORGANIZATION_NAME=TexasRenters
# Optional. Generated when absent; set it only to match an existing id.
BOOTSTRAP_ADMIN_ORGANIZATION_ID=

# -----------------------------------------------------------------------------
# Report branding — appears on every report sent to a tenant
# -----------------------------------------------------------------------------
REPORT_BRAND_NAME=TexasRenters.com
REPORT_BRAND_ADDRESS_LINE1=
REPORT_BRAND_ADDRESS_LINE2=
REPORT_BRAND_PHONE=
REPORT_BRAND_EMAIL=

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
SENTRY_DSN=
SLOW_REQUEST_WARNING_MS=750
SLOW_QUERY_WARNING_MS=250
