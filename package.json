{
  "name": "texasrenters-inspection",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm start --prefix mobile",
    "dev": "concurrently -n backend,web,mobile -c blue,green,magenta \"npm run dev:backend\" \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:mobile": "npm run --workspace @texasrenters/mobile start",
    "dev:mobile:clear": "npm run --workspace @texasrenters/mobile start:clear",
    "dev:web": "npm run --workspace @texasrenters/web dev",
    "dev:backend": "npm run --workspace @texasrenters/backend dev",
    "build:mobile": "npm run --workspace @texasrenters/mobile build",
    "build:web": "npm run --workspace @texasrenters/web build",
    "build:backend": "npm run --workspace @texasrenters/backend build",
    "build": "npm run --workspaces --if-present build",
    "lint:mobile": "npm run --workspace @texasrenters/mobile lint",
    "lint:web": "npm run --workspace @texasrenters/web lint",
    "lint:backend": "npm run --workspace @texasrenters/backend lint",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck:mobile": "npm run --workspace @texasrenters/mobile typecheck",
    "typecheck:web": "npm run --workspace @texasrenters/web typecheck",
    "typecheck:backend": "npm run --workspace @texasrenters/backend typecheck",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test:mobile": "npm run --workspace @texasrenters/mobile test",
    "test:web": "npm run --workspace @texasrenters/web test",
    "test:backend": "npm run --workspace @texasrenters/backend test",
    "test": "npm run --workspaces --if-present test",
    "perf:database": "npm run --workspace @texasrenters/backend perf:database",
    "perf:database:session": "npm run --workspace @texasrenters/backend perf:database:session",
    "perf:endpoints": "npm run --workspace @texasrenters/backend perf:endpoints",
    "perf:backend": "npm run --workspace @texasrenters/backend perf:backend",
    "perf:query-plans": "npm run --workspace @texasrenters/backend perf:query-plans",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run --workspace @texasrenters/backend db:generate",
    "db:migrate": "npm run --workspace @texasrenters/backend db:migrate",
    "db:seed": "npm run --workspace @texasrenters/backend db:seed",
    "db:seed:super-admin": "npm run --workspace @texasrenters/backend db:seed:super-admin",
    "propertyware:status": "npm run --workspace @texasrenters/backend propertyware:status",
    "propertyware:sync:dry-run": "npm run --workspace @texasrenters/backend propertyware:sync:dry-run",
    "propertyware:sync:buildings:dry-run": "npm run --workspace @texasrenters/backend propertyware:sync:buildings:dry-run",
    "propertyware:sync:initial": "npm run --workspace @texasrenters/backend propertyware:sync:initial",
    "propertyware:sync:buildings:initial": "npm run --workspace @texasrenters/backend propertyware:sync:buildings:initial",
    "propertyware:reconcile:buildings": "npm run --workspace @texasrenters/backend propertyware:reconcile:buildings",
    "propertyware:sync:incremental": "npm run --workspace @texasrenters/backend propertyware:sync:incremental",
    "propertyware:reconcile": "npm run --workspace @texasrenters/backend propertyware:reconcile",
    "propertyware:verify:db": "npm run --workspace @texasrenters/backend propertyware:verify:db",
    "docker:up": "docker compose --env-file web/.env.local up -d --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "docker:config": "node scripts/docker/config.mjs",
    "prod:up": "docker compose --env-file .env.production -f compose.yaml -f compose.production.yaml up -d",
    "prod:build": "docker compose --env-file .env.production -f compose.yaml -f compose.production.yaml build",
    "prod:down": "docker compose --env-file .env.production -f compose.yaml -f compose.production.yaml down",
    "prod:ps": "docker compose --env-file .env.production -f compose.yaml -f compose.production.yaml ps",
    "prod:logs": "docker compose --env-file .env.production -f compose.yaml -f compose.production.yaml logs -f",
    "remote-beta": "node scripts/remote-beta/start.mjs",
    "remote-beta:status": "node scripts/remote-beta/status.mjs",
    "remote-beta:stop": "node scripts/remote-beta/stop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "15.5.20",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "workspaces": [
    "shared",
    "backend",
    "web",
    "mobile"
  ],
  "allowScripts": {
    "prisma@6.19.0": true,
    "@prisma/client@6.19.0": true,
    "@prisma/engines@6.19.0": true,
    "sharp@0.34.5": true,
    "ffmpeg-static@5.3.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  },
  "overrides": {
    "@types/react": "~19.1.10"
  }
}
