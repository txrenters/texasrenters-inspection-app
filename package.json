{
  "name": "texasrenters-inspection",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @texasrenters/backend --filter @texasrenters/mobile --filter @texasrenters/web-app dev",
    "dev:mobile": "pnpm --filter @texasrenters/mobile dev",
    "dev:mobile:lan": "pnpm --filter @texasrenters/mobile dev:lan",
    "dev:mobile:tunnel": "pnpm --filter @texasrenters/mobile start:tunnel",
    "dev:mobile:clear": "pnpm --filter @texasrenters/mobile dev:clear",
    "windows:mobile:lan:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/scripts/windows-lan-firewall.ps1",
    "windows:mobile:lan:firewall:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/scripts/windows-lan-firewall.ps1 -Remove",
    "dev:web": "pnpm --filter @texasrenters/web-app dev",
    "dev:backend": "pnpm --filter @texasrenters/backend dev",
    "build:mobile": "pnpm --filter @texasrenters/mobile build",
    "build:web": "pnpm --filter @texasrenters/web-app build",
    "build:backend": "pnpm --filter @texasrenters/backend build",
    "build": "pnpm -r build",
    "lint:mobile": "pnpm --filter @texasrenters/mobile lint",
    "lint:web": "pnpm --filter @texasrenters/web-app lint",
    "lint:backend": "pnpm --filter @texasrenters/backend lint",
    "lint": "pnpm -r lint",
    "typecheck:mobile": "pnpm --filter @texasrenters/mobile typecheck",
    "typecheck:web": "pnpm --filter @texasrenters/web-app typecheck",
    "typecheck:backend": "pnpm --filter @texasrenters/backend typecheck",
    "typecheck": "pnpm -r typecheck",
    "test:mobile": "pnpm --filter @texasrenters/mobile test",
    "test:web": "pnpm --filter @texasrenters/web-app test",
    "test:backend": "pnpm --filter @texasrenters/backend test",
    "test": "pnpm -r test",
    "perf:database": "pnpm --filter @texasrenters/backend perf:database",
    "perf:database:session": "pnpm --filter @texasrenters/backend perf:database:session",
    "perf:endpoints": "pnpm --filter @texasrenters/backend perf:endpoints",
    "perf:backend": "pnpm --filter @texasrenters/backend perf:backend",
    "perf:query-plans": "pnpm --filter @texasrenters/backend perf:query-plans",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @texasrenters/backend db:generate",
    "db:migrate": "pnpm --filter @texasrenters/backend db:migrate",
    "db:seed": "pnpm --filter @texasrenters/backend db:seed",
    "db:seed:super-admin": "pnpm --filter @texasrenters/backend db:seed:super-admin",
    "propertyware:status": "pnpm --filter @texasrenters/backend propertyware:status",
    "propertyware:sync:dry-run": "pnpm --filter @texasrenters/backend propertyware:sync:dry-run",
    "propertyware:sync:buildings:dry-run": "pnpm --filter @texasrenters/backend propertyware:sync:buildings:dry-run",
    "propertyware:sync:initial": "pnpm --filter @texasrenters/backend propertyware:sync:initial",
    "propertyware:sync:buildings:initial": "pnpm --filter @texasrenters/backend propertyware:sync:buildings:initial",
    "propertyware:reconcile:buildings": "pnpm --filter @texasrenters/backend propertyware:reconcile:buildings",
    "propertyware:sync:incremental": "pnpm --filter @texasrenters/backend propertyware:sync:incremental",
    "propertyware:reconcile": "pnpm --filter @texasrenters/backend propertyware:reconcile",
    "propertyware:verify:db": "pnpm --filter @texasrenters/backend propertyware:verify:db",
    "docker:up": "docker compose --env-file web-app/.env.local up -d --build",
    "docker:down": "docker compose down",
    "db:migrate-to-local": "pnpm --filter @texasrenters/backend db:migrate-to-local",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "docker:config": "node scripts/docker/config.mjs",
    "remote-beta": "node scripts/remote-beta/start.mjs",
    "remote-beta:status": "node scripts/remote-beta/status.mjs",
    "remote-beta:stop": "node scripts/remote-beta/stop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "15.5.20",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "prettier": "^3.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
