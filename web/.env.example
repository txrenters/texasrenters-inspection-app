NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Mapbox, which draws every map in this console.
#
# A `pk.` token is public by design and ships in the JavaScript bundle, so
# restrict it by URL in the Mapbox account rather than treating it as a secret.
#
# It must start with `pk.`. An `sk.` token is a secret key: browsers refuse it,
# so the maps go blank, and putting it here publishes it to every visitor.
NEXT_PUBLIC_MAPBOX_TOKEN=
