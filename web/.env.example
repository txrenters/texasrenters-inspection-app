NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Google Maps browser key, for the technician map.
#
# Public by nature: inlined into the JavaScript bundle and visible to anyone
# who reads the page, which is true of every Maps browser key. Google's answer
# is HTTP referrer restrictions, not secrecy -- restrict it to this console's
# hosts, because an unrestricted key is one anybody can spend.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# The styled map to draw on. Required rather than decorative: AdvancedMarker
# is only available to a map that has one. Created under Map Management.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
