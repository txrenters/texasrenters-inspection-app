  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreatePropertyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "addressLine1": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "object",
            "default": "TX"
          },
          "postalCode": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "addressLine1",
          "city",
          "state",
          "postalCode"
        ]
      },
      "UpdatePropertyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "addressLine1": {
            "type": "string"
          }
        }
      },
      "RegisterFloorPlanDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png"
            ]
          },
          "sizeBytes": {
            "type": "number",
            "maximum": 20000000
          }
        },
        "required": [
          "fileName",
          "mimeType",
          "sizeBytes"
        ]
      },
      "CreateAreaDto": {
        "type": "object",
        "properties": {
          "floorName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "inspectionOrder": {
            "type": "number"
          },
          "isRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "floorName",
          "name",
          "inspectionOrder",
          "isRequired"
        ]
      },
      "UpdateAreaDto": {
        "type": "object",
        "properties": {
          "floorName": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "inspectionOrder": {
            "type": "number"
          },
          "isRequired": {
            "type": "boolean"
          }
        }
      },
      "AreaOrderDto": {
        "type": "object",
        "properties": {
          "areaIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "areaIds"
        ]
      },
      "CreateInspectionDto": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "technicianId": {
            "type": "string"
          },
          "scheduledAt": {
            "type": "string"
          }
        },
        "required": [
          "propertyId",
          "technicianId",
          "scheduledAt"
        ]
      },
      "ReasonDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "UploadSessionDto": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          }
        },
        "required": [
          "idempotencyKey",
          "fileName",
          "mimeType"
        ]
      },
      "RegisterMediaDto": {
        "type": "object",
        "properties": {
          "providerUploadId": {
            "type": "string"
          },
          "providerMediaId": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number"
          }
        },
        "required": [
          "providerUploadId",
