{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "remote-beta",
        "EXPO_PUBLIC_ENABLE_DEMO_DATA": "false",
        "EXPO_PUBLIC_ENABLE_TEST_VIDEO_PICKER": "false",
        "EXPO_PUBLIC_USE_ADB_REVERSE": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ENABLE_DEMO_DATA": "false",
        "EXPO_PUBLIC_ENABLE_TEST_VIDEO_PICKER": "false",
        "EXPO_PUBLIC_USE_ADB_REVERSE": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
