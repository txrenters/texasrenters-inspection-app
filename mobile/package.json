{
  "name": "@texasrenters/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "TexasRenters technician inspection application",
  "scripts": {
    "prestart": "npm run build --prefix ../shared",
    "prestart:clear": "npm run build --prefix ../shared",
    "eas-build-post-install": "npm run build --prefix ../shared",
    "start": "node scripts/start-tunnel.mjs",
    "start:clear": "node scripts/start-tunnel.mjs --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint app src tests",
    "pretypecheck": "npm run build --prefix ../shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build --prefix ../shared",
    "test": "jest --runInBand",
    "build": "expo export --platform web --output-dir dist",
    "build:dev": "eas build -p all --profile development",
    "build:preview": "eas build -p all --profile preview",
    "build:production": "eas build -p all --profile production",
    "submit": "eas submit",
    "update": "eas update",
    "export:web": "expo export -p web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "5.101.2",
    "@texasrenters/shared": "*",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.8",
    "expo-camera": "17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "6.0.24",
    "expo-secure-store": "15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "lucide-react-native": "^0.545.0",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.7",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1",
    "socket.io-client": "4.8.1",
    "tailwindcss": "^3.4.17",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "dotenv": "^16.4.5",
    "eslint": "9.37.0",
    "eslint-config-expo": "10.0.0",
    "jest": "29.7.0",
    "jest-expo": "~54.0.18",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "typescript": "5.9.3"
  },
  "private": true
}
